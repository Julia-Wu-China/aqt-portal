var HANZI_MAP = {};
HANZI.forEach(function(h){ HANZI_MAP[h[0]] = { c:h[0], py:h[1], w:h[2] }; });
var HZ_PY_POOL = (function(){ var s = new Set(); HANZI.forEach(function(h){ s.add(h[1]); }); return Array.from(s); })();
function hzDistractors(ans){
  var out = [], guard = 0;
  while(out.length < 3 && guard < 300){
    guard++;
    var py = pick(HZ_PY_POOL);
    if(py !== ans && out.indexOf(py) === -1) out.push(py);
  }
  return out;
}
var hzFilter = 'all', hzGroup = 'g1', hzPageN = 1, HZ_PAGE_SIZE = 120;
