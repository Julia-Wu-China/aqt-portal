<!DOCTYPE html>
<!-- 本工作台通过 WorkBuddy 资料库能力（library skill）部署；学习数据存 localStorage（用户指定） -->
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>学习乐园 · 花花的学习乐园</title>
<style>
:root{
  --pink:#FF9EB5; --pink-d:#F4789C; --pink-bg:#FFF0F4;
  --blue:#6EC6FF; --blue-d:#3E9BE0; --blue-bg:#EEF7FF;
  --yellow:#FFD36E; --yellow-d:#F0B23C; --yellow-bg:#FFF8E6;
  --green:#7ED9A0; --green-d:#4BBE7B; --green-bg:#EDFAF1;
  --purple:#B79CFF; --purple-d:#8F6FE8; --purple-bg:#F5F0FF;
  --ink:#5A4A5E; --ink-soft:#8C7E92;
  --card:#FFFFFF; --bg:#FFF8F1;
  --radius:20px;
  --shadow:0 6px 20px rgba(180,140,160,.12);
}
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{height:100%}
body{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"PingFang SC","Microsoft YaHei",sans-serif;background:var(--bg);color:var(--ink);font-size:16px;line-height:1.5}
button{font-family:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,select{font-family:inherit}
img{display:block}

/* ===== 布局骨架 ===== */
.app{display:flex;min-height:100vh}
.sidebar{width:216px;flex-shrink:0;background:var(--card);border-right:1px solid #F3E4EC;padding:20px 14px;display:flex;flex-direction:column;position:sticky;top:0;height:100vh;overflow-y:auto}
.main{flex:1;min-width:0;padding:22px 26px 40px}
.bottom-tab{display:none}

/* ===== Logo ===== */
.logo{display:flex;align-items:center;gap:10px;padding:6px 8px 18px}
.logo-badge{width:46px;height:46px;border-radius:14px;background:linear-gradient(135deg,var(--pink),var(--purple));display:flex;align-items:center;justify-content:center;flex-shrink:0;box-shadow:0 4px 12px rgba(180,120,200,.35)}
.logo h1{font-size:19px;font-weight:800;letter-spacing:1px}
.logo small{display:block;font-size:11px;color:var(--ink-soft);font-weight:400}

/* ===== 星星面板 ===== */
.star-panel{background:linear-gradient(135deg,#FFF3D6,#FFE9B8);border-radius:var(--radius);padding:12px 14px;margin-bottom:16px;display:flex;align-items:center;gap:10px;border:1px solid #FFE1A1}
.star-ico{width:34px;height:34px;border-radius:50%;background:#FFD36E;display:flex;align-items:center;justify-content:center;box-shadow:0 3px 8px rgba(240,178,60,.4);flex-shrink:0}
.star-num{font-size:24px;font-weight:900;color:#C77E00;line-height:1}
.star-label{font-size:11px;color:#B58A3C}

/* ===== 侧边导航 ===== */
.nav{flex:1;display:flex;flex-direction:column;gap:6px}
.nav-btn{display:flex;align-items:center;gap:11px;padding:12px 14px;border-radius:14px;font-size:15px;font-weight:700;color:var(--ink-soft);transition:background .15s;text-align:left;min-height:44px}
.nav-btn svg{flex-shrink:0}
.nav-btn:hover{background:#FAF1F6}
.nav-btn.active{background:linear-gradient(135deg,#FFF0F4,#F5F0FF);color:var(--ink);box-shadow:inset 0 0 0 2px rgba(255,158,181,.5)}
.nav-btn .badge{margin-left:auto;background:var(--pink);color:#fff;font-size:11px;padding:1px 8px;border-radius:10px;font-weight:700}

/* ===== 底部按钮 ===== */
.foot-btn{margin-top:14px;display:flex;align-items:center;gap:10px;padding:12px 14px;border-radius:14px;font-size:14px;font-weight:700;color:var(--ink-soft);min-height:44px}
.foot-btn:hover{background:#FAF1F6}

/* ===== 页面 ===== */
.page{display:none;animation:pop .25s ease}
.page.active{display:block}
@keyframes pop{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.page-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px;flex-wrap:wrap}
.page-title{font-size:24px;font-weight:900;display:flex;align-items:center;gap:10px}
.page-sub{color:var(--ink-soft);font-size:13px;margin-top:2px}

/* ===== 卡片 ===== */
.card{background:var(--card);border-radius:var(--radius);padding:18px;box-shadow:var(--shadow);border:1px solid #F6E9F0;margin-bottom:16px}
.card-title{font-size:16px;font-weight:800;display:flex;align-items:center;gap:8px;margin-bottom:12px}
.chip{display:inline-block;font-size:11px;font-weight:700;padding:2px 10px;border-radius:10px}

/* ===== 今日任务 ===== */
.today-wrap{background:linear-gradient(135deg,#FFF0F4,#EEF7FF);border:2px solid #FFD3E2;border-radius:22px;padding:18px;margin-bottom:20px}
.today-head{display:flex;align-items:center;gap:10px;margin-bottom:12px}
.today-head .big{font-size:17px;font-weight:900}
.today-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:10px}
.task-item{background:var(--card);border-radius:16px;padding:12px 14px;display:flex;align-items:center;gap:12px;border:1px solid #F3E4EC}
.task-ico{width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.task-info{flex:1;min-width:0}
.task-name{font-weight:800;font-size:14px;display:flex;align-items:center;gap:6px}
.task-bar{height:8px;background:#F3E4EC;border-radius:5px;margin-top:6px;overflow:hidden}
.task-bar i{display:block;height:100%;border-radius:5px;background:linear-gradient(90deg,var(--green),var(--blue));transition:width .3s}
.task-txt{font-size:11px;color:var(--ink-soft);margin-top:4px}
.task-btn{min-width:64px;min-height:44px;padding:0 12px;border-radius:12px;font-size:14px;font-weight:800;color:#fff;background:var(--pink-d);display:flex;align-items:center;justify-content:center}
.task-btn.done{background:#E8D9EE;color:#9A7DA8}
.task-item.overdue{border-color:#FF9EB5;background:#FFF5F7}
.task-item.overdue .task-btn{background:#FF6B8E}
.task-item.overdue .task-name::after{content:'昨天没完成，今天继续加油';font-size:10px;color:#FF6B8E;font-weight:700;background:#FFE9EF;padding:1px 7px;border-radius:8px;margin-left:4px}

/* ===== 首页模块入口 ===== */
.mod-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px}
.mod-card{border-radius:22px;padding:20px 16px;min-height:150px;display:flex;flex-direction:column;gap:10px;position:relative;overflow:hidden;border:2px solid transparent;transition:transform .15s;text-align:left;color:var(--ink)}
.mod-card:hover{transform:translateY(-3px)}
.mod-card .m-ico{width:54px;height:54px;border-radius:18px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.85);box-shadow:0 4px 12px rgba(0,0,0,.06)}
.mod-card .m-name{font-size:19px;font-weight:900}
.mod-card .m-desc{font-size:12px;color:rgba(90,74,94,.75);line-height:1.4}
.mod-card .m-go{position:absolute;right:12px;top:12px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.9);display:flex;align-items:center;justify-content:center}
.mc-pink{background:linear-gradient(135deg,#FFC9D8,#FF9EB5);border-color:#FFB3C8}
.mc-blue{background:linear-gradient(135deg,#BFE3FF,#6EC6FF);border-color:#9AD3FF}
.mc-yellow{background:linear-gradient(135deg,#FFE9B0,#FFD36E);border-color:#FFDF96}
.mc-green{background:linear-gradient(135deg,#B9EFCC,#7ED9A0);border-color:#9FE6B8}
.mc-purple{background:linear-gradient(135deg,#DECBFF,#B79CFF);border-color:#CBB0FF}
.mc-red{background:linear-gradient(135deg,#FFC9A8,#FF8A7A);border-color:#FFB08E}

/* ===== 星星徽章 ===== */
.badge-row{display:flex;gap:8px;flex-wrap:wrap}
.badge{width:64px;text-align:center}
.badge .b-ico{width:56px;height:56px;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 4px;background:#F0E6F4;position:relative}
.badge .b-ico.lit{background:linear-gradient(135deg,#FFD36E,#FFB347);box-shadow:0 4px 14px rgba(255,179,71,.5)}
.badge .b-name{font-size:10px;color:var(--ink-soft);font-weight:700;line-height:1.2}

/* ===== 通用按钮 ===== */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:0 20px;border-radius:14px;font-size:16px;font-weight:800;color:#fff;transition:transform .12s}
.btn:active{transform:scale(.96)}
.btn-pink{background:var(--pink-d)} .btn-blue{background:var(--blue-d)} .btn-green{background:var(--green-d)} .btn-yellow{background:var(--yellow-d)} .btn-purple{background:var(--purple-d)}
.btn-ghost{background:#F3E4EC;color:var(--ink)}
.btn-big{min-height:52px;font-size:18px;padding:0 28px;border-radius:16px}
.btn-sm{min-height:40px;padding:0 14px;font-size:14px;border-radius:12px}

/* ===== 语音按钮 ===== */
.say-btn{width:52px;height:52px;border-radius:50%;background:linear-gradient(135deg,#6EC6FF,#3E9BE0);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(62,155,224,.4);flex-shrink:0}
.say-btn:active{transform:scale(.92)}
.say-btn.small{width:40px;height:40px}

/* ===== 英语模块 ===== */
.seg{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap}
.seg-btn{min-height:44px;padding:0 18px;border-radius:12px;background:#F3E4EC;font-weight:800;font-size:14px;color:var(--ink-soft)}
.seg-btn.active{background:var(--pink-d);color:#fff}
.book-group{margin-bottom:10px}
.book-group-title{font-size:12px;font-weight:800;color:var(--ink-soft);margin-bottom:6px;padding-left:2px;display:flex;align-items:center;gap:4px;opacity:.7}
.book-group-tags{display:flex;gap:8px;flex-wrap:wrap}
#bookSeg{flex-direction:column;gap:0}
.word-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px}
.word-card{background:var(--card);border-radius:16px;padding:14px 12px;border:1px solid #F3E4EC;display:flex;flex-direction:column;align-items:center;gap:8px;cursor:pointer;transition:transform .12s;box-shadow:var(--shadow)}
.word-card:hover{transform:translateY(-2px)}
.word-card .w-pic{width:64px;height:64px;border-radius:16px;background:var(--blue-bg);display:flex;align-items:center;justify-content:center;font-size:34px}
.word-card .w-en{font-size:17px;font-weight:900;letter-spacing:.5px}
.word-card .w-cn{font-size:12px;color:var(--ink-soft);font-weight:700}
.word-card .w-phone{font-size:11px;color:#B58AC8;font-weight:600}
.word-card.learned{border-color:#7ED9A0;background:#F4FCF6}
.word-card .w-check{font-size:10px;color:var(--green-d);font-weight:800}
.word-card .w-tag{position:absolute;top:8px;right:8px;background:#F3E9FB;color:#9B59C6;font-size:9px;font-weight:800;padding:2px 6px;border-radius:8px;line-height:1}
.word-card{position:relative}
.quiz-box{background:var(--card);border-radius:22px;padding:22px;box-shadow:var(--shadow);text-align:center;border:1px solid #F6E9F0}
.quiz-big-word{font-size:42px;font-weight:900;margin:8px 0;color:var(--blue-d)}
.opt-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(120px,1fr));gap:10px;margin-top:16px}
.opt-btn{min-height:56px;border-radius:16px;background:#F8EEF4;font-size:17px;font-weight:800;color:var(--ink);border:2px solid transparent;display:flex;align-items:center;justify-content:center;gap:10px}
.opt-btn:active{transform:scale(.96)}
.opt-btn.correct{background:#E2F7EA;border-color:var(--green);color:var(--green-d)}
.opt-btn.wrong{background:#FFE9EE;border-color:var(--pink);color:#E0557B;animation:shake .3s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.quiz-feedback{min-height:26px;margin-top:12px;font-weight:800;font-size:15px}
.quiz-score{font-size:13px;color:var(--ink-soft);font-weight:700}

/* ===== 古诗模块 ===== */
.poem-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:14px}
.poem-card{background:var(--card);border-radius:18px;padding:16px 18px;border:1px solid #F3E4EC;box-shadow:var(--shadow);position:relative}
.poem-title{font-size:19px;font-weight:900;color:#8F6FE8;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.poem-author{font-size:12px;color:var(--ink-soft);font-weight:700;margin:2px 0 10px}
.poem-lines{font-size:17px;font-weight:700;line-height:1.9;letter-spacing:1px}
.poem-lines .py{font-size:12px;color:#B79CFF;font-weight:600;letter-spacing:0;margin-left:6px}
.poem-card .say-btn{position:absolute;right:14px;top:14px}
.poem-card.done{border-color:var(--green);background:#F7FDF9}
.poem-card.done::after{content:'已会背';position:absolute;right:14px;bottom:12px;font-size:10px;font-weight:800;color:var(--green-d);background:#E2F7EA;padding:2px 8px;border-radius:8px}

/* ===== 数字模块 ===== */
.num-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:10px}
.num-card{background:var(--card);border-radius:16px;padding:12px 8px;text-align:center;border:1px solid #F3E4EC;cursor:pointer;box-shadow:var(--shadow);transition:transform .12s}
.num-card:hover{transform:translateY(-2px)}
.num-card .n-big{font-size:26px;font-weight:900;color:var(--blue-d)}
.num-card .n-en{font-size:11px;font-weight:700;color:var(--ink-soft)}
.num-card .n-dots{display:flex;flex-wrap:wrap;gap:3px;justify-content:center;margin-top:6px;max-width:100%}
.num-card .dot{width:7px;height:7px;border-radius:50%;background:var(--pink)}
.quiz-math-word{font-size:40px;font-weight:900;letter-spacing:3px;margin:10px 0;color:var(--ink)}
.count-game{display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center}
.count-fruits{font-size:34px;line-height:1.5;letter-spacing:4px;background:#FFF9E8;border-radius:16px;padding:14px 18px;border:1px solid #FFE9B0;max-width:100%}

/* ===== 逻辑模块 ===== */
.logic-board{display:flex;align-items:center;gap:14px;flex-wrap:wrap;justify-content:center;background:#F8F2FF;border-radius:18px;padding:20px;border:1px solid #E8DBFF;min-height:110px}
.shape{display:inline-flex}
.logic-ask{font-size:18px;font-weight:800;margin-top:14px;color:var(--purple-d)}
.sort-row{display:flex;gap:10px;flex-wrap:wrap;justify-content:center}
.sort-item{width:52px;height:52px;border-radius:14px;background:#fff;border:2px dashed #D9C6F5;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;color:var(--purple-d);cursor:pointer}
.sort-item.sorted{border-style:solid;border-color:var(--green);background:#E2F7EA;color:var(--green-d)}
.sort-item.pick{border-color:var(--pink);background:#FFF0F4}

/* ===== 闯关 ===== */
.adv-stats{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:16px}
.adv-stat{background:var(--card);border-radius:16px;padding:12px 18px;box-shadow:var(--shadow);display:flex;align-items:center;gap:10px;min-width:130px}
.adv-stat .v{font-size:22px;font-weight:900;color:var(--yellow-d)}
.adv-stat .l{font-size:12px;color:var(--ink-soft);font-weight:700}
.level-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:12px}
.level-card{border-radius:18px;padding:16px 12px;text-align:center;min-height:110px;display:flex;flex-direction:column;align-items:center;gap:8px;background:var(--card);border:2px solid #F3E4EC;cursor:pointer;transition:transform .12s;box-shadow:var(--shadow)}
.level-card:hover{transform:translateY(-2px)}
.level-card.locked{opacity:.55;cursor:not-allowed;filter:grayscale(.3)}
.level-card .lv-num{font-size:22px;font-weight:900}
.level-card .lv-name{font-size:12px;font-weight:800;color:var(--ink-soft)}
.level-stars{display:flex;gap:2px}
.adv-q{font-size:22px;font-weight:900;margin:12px 0}
.adv-progress{height:10px;background:#F3E4EC;border-radius:6px;overflow:hidden;margin-bottom:14px}
.adv-progress i{display:block;height:100%;background:linear-gradient(90deg,var(--pink),var(--purple));transition:width .3s;border-radius:6px}

/* ===== 徽章墙 ===== */
.badge-wall{display:grid;grid-template-columns:repeat(auto-fill,minmax(86px,1fr));gap:12px}
.badge-wall .badge{width:auto;padding:10px 4px;background:var(--card);border-radius:16px;border:1px solid #F3E4EC;box-shadow:var(--shadow)}
.badge-wall .badge .b-ico{margin-bottom:6px}

/* ===== 设置抽屉 ===== */
.drawer-mask{position:fixed;inset:0;background:rgba(90,74,94,.4);z-index:90;opacity:0;pointer-events:none;transition:opacity .25s}
.drawer-mask.open{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;right:0;bottom:0;width:min(400px,92vw);background:#fff;z-index:91;transform:translateX(100%);transition:transform .28s ease;padding:24px 22px;overflow-y:auto;box-shadow:-8px 0 30px rgba(90,74,94,.15)}
.drawer.open{transform:none}
.drawer h3{font-size:19px;font-weight:900;margin-bottom:16px}
.field{margin-bottom:16px}
.field label{display:block;font-size:13px;font-weight:800;color:var(--ink-soft);margin-bottom:6px}
.field input,.field select{width:100%;min-height:48px;border:2px solid #EED9E8;border-radius:12px;padding:0 14px;font-size:17px;color:var(--ink);background:#fff}
.field input:focus{outline:none;border-color:var(--pink)}
.drawer .btn{width:100%;margin-bottom:10px}

/* ===== Toast ===== */
#toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%) translateY(20px);background:rgba(90,74,94,.94);color:#fff;padding:12px 22px;border-radius:14px;font-size:15px;font-weight:700;z-index:99;opacity:0;pointer-events:none;transition:all .25s;max-width:86vw;text-align:center}
#toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ===== 庆祝动画 ===== */
.confetti{position:fixed;top:-20px;width:12px;height:12px;border-radius:3px;z-index:98;pointer-events:none;animation:fall 1.6s ease-in forwards}
@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.6}}
.star-burst{position:fixed;left:50%;top:45%;transform:translate(-50%,-50%) scale(0);z-index:97;font-size:70px;pointer-events:none;animation:burst .8s ease forwards}
@keyframes burst{0%{transform:translate(-50%,-50%) scale(0)}50%{transform:translate(-50%,-50%) scale(1.4)}100%{transform:translate(-50%,-50%) scale(1)}}

/* ===== 识字模块 ===== */
.hz-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(58px,1fr));gap:10px}
.hz-card{aspect-ratio:1;background:var(--card);border-radius:14px;border:1px solid #F3E4EC;display:flex;align-items:center;justify-content:center;font-size:26px;font-weight:900;color:var(--ink);cursor:pointer;box-shadow:var(--shadow);transition:transform .12s;position:relative;-webkit-tap-highlight-color:rgba(255,158,181,.2)}
.hz-card:hover{transform:translateY(-2px)}
.hz-card:active{transform:scale(.95)}
.hz-card.known{background:#FFF1EE;border-color:#FFC9B8;color:#F2654F}
.hz-card.known::after{content:'✓';position:absolute;right:3px;bottom:1px;font-size:11px;font-weight:900;color:#F2654F}
.hz-page{display:flex;gap:12px;justify-content:center;margin-top:16px;align-items:center}
.hz-mask{position:fixed;inset:0;background:rgba(90,74,94,.5);z-index:95;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .2s;padding:20px}
.hz-mask.open{opacity:1;pointer-events:auto}
.hz-pop{background:#fff;border-radius:28px;padding:28px 24px;max-width:430px;width:100%;text-align:center;position:relative;transform:scale(.9);transition:transform .2s;box-shadow:0 20px 60px rgba(90,74,94,.3);max-height:88vh;overflow-y:auto}
.hz-mask.open .hz-pop{transform:scale(1)}
.hz-close{position:absolute;right:12px;top:10px;width:36px;height:36px;border-radius:50%;background:#F3E4EC;font-size:16px;font-weight:900;color:var(--ink-soft);display:flex;align-items:center;justify-content:center}
.hz-nav{position:absolute;top:50%;transform:translateY(-50%);width:42px;height:42px;border-radius:50%;background:#F3E4EC;color:var(--ink-soft);display:flex;align-items:center;justify-content:center;z-index:2;transition:background .15s}
.hz-nav:not(:disabled):active{transform:translateY(-50%) scale(.92)}
.hz-nav:disabled{opacity:.35}
.hz-nav svg{display:block}
.hz-prev{left:6px}
.hz-next{right:6px}
.hz-pos{font-size:13px;font-weight:800;color:var(--ink-soft);margin-bottom:4px}
.hz-big{font-size:110px;font-weight:900;line-height:1;color:var(--ink);width:1.35em;height:1.35em;margin:0 auto;border:3px solid #FFD6C2;border-radius:12px;display:flex;align-items:center;justify-content:center;position:relative;background:#fff url("data:image/svg+xml,%3Csvg%20xmlns%3D'http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg'%20viewBox%3D'0%200%20100%20100'%3E%3Cline%20x1%3D'50'%20y1%3D'2'%20x2%3D'50'%20y2%3D'98'%20stroke%3D'%23FFE4D9'%20stroke-width%3D'1.5'%20stroke-dasharray%3D'5%205'%2F%3E%3Cline%20x1%3D'2'%20y1%3D'50'%20x2%3D'98'%20y2%3D'50'%20stroke%3D'%23FFE4D9'%20stroke-width%3D'1.5'%20stroke-dasharray%3D'5%205'%2F%3E%3Cline%20x1%3D'2'%20y1%3D'2'%20x2%3D'98'%20y2%3D'98'%20stroke%3D'%23FFE4D9'%20stroke-width%3D'1.5'%20stroke-dasharray%3D'5%205'%2F%3E%3Cline%20x1%3D'98'%20y1%3D'2'%20x2%3D'2'%20y2%3D'98'%20stroke%3D'%23FFE4D9'%20stroke-width%3D'1.5'%20stroke-dasharray%3D'5%205'%2F%3E%3C%2Fsvg%3E") center/contain no-repeat;box-shadow:inset 0 0 0 2px #FFF8F2}
.hz-py{font-size:34px;font-weight:900;color:#3E9BE0;letter-spacing:2px;margin-top:8px}
.hz-words{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:18px}
.hz-word{padding:9px 16px;border-radius:12px;background:#FFF8E6;border:1px solid #FFE1A1;font-size:17px;font-weight:800;color:#B57A00;cursor:pointer;min-height:40px;display:inline-flex;align-items:center}
.hz-actions{display:flex;gap:12px;justify-content:center;margin-top:22px}
.hz-actions .btn{flex:1}
.hz-tip{font-size:12px;color:var(--ink-soft);font-weight:700;margin-top:12px}

/* ===== 移动端 ===== */
@media (max-width:768px){
  .sidebar{display:none}
  .main{padding:16px 14px calc(88px + env(safe-area-inset-bottom))}
  .bottom-tab{display:flex;position:fixed;left:0;right:0;bottom:0;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-top:1px solid #F3E4EC;z-index:80;padding-bottom:env(safe-area-inset-bottom)}
  .bt-btn{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;padding:9px 2px 7px;min-height:56px;font-size:10px;font-weight:800;color:var(--ink-soft)}
  .bt-btn.active{color:var(--pink-d)}
  .bt-btn svg{width:24px;height:24px}
  .page-title{font-size:21px}
  .today-grid{grid-template-columns:1fr}
  .mod-grid{grid-template-columns:1fr 1fr}
  .word-grid{grid-template-columns:repeat(auto-fill,minmax(120px,1fr))}
  .opt-grid{grid-template-columns:1fr 1fr}
  .hz-big{font-size:78px}
  .hz-py{font-size:28px}
  #toast{bottom:100px}
}
@media (max-width:420px){
  .mod-grid{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="app">

  <!-- ===== 侧边栏（PC） ===== -->
  <aside class="sidebar" id="sidebar">
    <div class="logo">
      <div class="logo-badge">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="#fff"/></svg>
      </div>
      <div>
        <h1>学习乐园</h1>
        <small>花花的学习天地</small>
      </div>
    </div>
    <div class="star-panel" id="starPanel">
      <div class="star-ico"><svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="#C77E00"/></svg></div>
      <div><div class="star-num" id="starTotal">0</div><div class="star-label">我的星星</div></div>
    </div>
    <nav class="nav" id="nav">
      <button class="nav-btn active" data-page="home">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
        首页
      </button>
      <button class="nav-btn" data-page="english">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg>
        英语乐园
      </button>
      <button class="nav-btn" data-page="hanzi">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
        识字乐园
      </button>
      <button class="nav-btn" data-page="poems">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3l2 4 4 1-3 3 1 4-4-2-4 2 1-4-3-3 4-1z"/><path d="M19 17l1 2 2 1-2 1-1 2-1-2-2-1 2-1z"/></svg>
        古诗花园
      </button>
      <button class="nav-btn" data-page="math">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
        数字王国
      </button>
      <button class="nav-btn" data-page="logic">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2" fill="currentColor" stroke="none"/></svg>
        逻辑挑战
      </button>
      <button class="nav-btn" data-page="adventure">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>
        闯关冒险
      </button>
    </nav>
    <button class="foot-btn" id="openSettings">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="3"/><path d="M19 12a7 7 0 00-.1-1.2l2-1.5-2-3.4-2.3 1a7 7 0 00-2-1.2L14.2 3h-4l-.4 2.7a7 7 0 00-2 1.2l-2.3-1-2 3.4 2 1.5A7 7 0 006 12c0 .4 0 .8.1 1.2l-2 1.5 2 3.4 2.3-1a7 7 0 002 1.2l.4 2.7h4l.4-2.7a7 7 0 002-1.2l2.3 1 2-3.4-2-1.5c.1-.4.1-.8.1-1.2z"/></svg>
      家长设置
    </button>
  </aside>

  <!-- ===== 主内容 ===== -->
  <main class="main" id="main">

    <!-- ===== 首页 ===== -->
    <section class="page active" id="page-home">
      <div class="today-wrap" id="todayWrap">
        <div class="today-head">
          <span class="chip" style="background:#FF9EB5;color:#fff">每日任务</span>
          <span class="big">今天要处理</span>
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700" id="todayDate"></span>
        </div>
        <div class="today-grid" id="todayGrid"></div>
      </div>
      <div class="page-head">
        <div>
          <div class="page-title">🌈 欢迎来到学习乐园</div>
          <div class="page-sub">每天进步一点点，坚持就是大赢家！</div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="#FFB347"/></svg>
          我的成就
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700">共 <span id="badgeCount">0</span> 枚徽章</span>
        </div>
        <div class="badge-row" id="homeBadges"></div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
          选择今天的学习内容
        </div>
        <div class="mod-grid">
          <button class="mod-card mc-pink" data-page="english">
            <span class="m-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#E0557B" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg></span>
            <span class="m-name">英语乐园</span>
            <span class="m-desc">自然拼读单词卡，点一点听发音，玩配对游戏</span>
            <span class="m-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#E0557B" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </button>
          <button class="mod-card mc-red" data-page="hanzi">
            <span class="m-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F2654F" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h8M8 12h8M8 16h5"/></svg></span>
            <span class="m-name">识字乐园</span>
            <span class="m-desc">认 3500 个常用汉字，学拼音，记词组</span>
            <span class="m-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#F2654F" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </button>
          <button class="mod-card mc-blue" data-page="poems">
            <span class="m-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#3E9BE0" stroke-width="2" stroke-linecap="round"><path d="M12 3l2 4 4 1-3 3 1 4-4-2-4 2 1-4-3-3 4-1z"/></svg></span>
            <span class="m-name">古诗花园</span>
            <span class="m-desc">经典古诗带拼音，点一点听朗读</span>
            <span class="m-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3E9BE0" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </button>
          <button class="mod-card mc-yellow" data-page="math">
            <span class="m-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#C77E00" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg></span>
            <span class="m-name">数字王国</span>
            <span class="m-desc">认数字、算加减法、玩数数小游戏</span>
            <span class="m-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#C77E00" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </button>
          <button class="mod-card mc-green" data-page="logic">
            <span class="m-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#2E9E62" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2" fill="#2E9E62" stroke="none"/></svg></span>
            <span class="m-name">逻辑挑战</span>
            <span class="m-desc">找规律、图形配对、排排序，开动小脑筋</span>
            <span class="m-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E9E62" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </button>
          <button class="mod-card mc-purple" data-page="adventure">
            <span class="m-ico"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#8F6FE8" stroke-width="2" stroke-linecap="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg></span>
            <span class="m-name">闯关冒险</span>
            <span class="m-desc">闯关赢星星，收集成就徽章</span>
            <span class="m-go"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#8F6FE8" stroke-width="2.5" stroke-linecap="round"><path d="M9 6l6 6-6 6"/></svg></span>
          </button>
        </div>
      </div>
    </section>

    <!-- ===== 英语乐园 ===== -->
    <section class="page" id="page-english">
      <div class="page-head">
        <div>
          <div class="page-title">🔤 英语乐园</div>
          <div class="page-sub">自然拼读 1-5 册 + 15 个常用主题分类 · 点卡片听发音 · 玩游戏学单词</div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg>
          单词卡片
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700" id="wordCount"></span>
        </div>
        <div class="seg" id="bookSeg"></div>
        <div class="word-grid" id="wordGrid"></div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
          听音配对游戏
          <span class="chip" style="background:#EEF7FF;color:#3E9BE0">听一听，选出对的单词</span>
        </div>
        <div class="quiz-box">
          <div class="quiz-score">第 <span id="mqNum">1</span> 题 · 答对 <span id="mqRight">0</span> 题</div>
          <div class="quiz-big-word" style="font-size:24px;font-weight:700;color:var(--ink-soft)">听发音，选出对应的单词👇</div>
          <button class="say-btn" style="margin:10px auto" id="mqSay">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="#fff"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16 8a5 5 0 010 8M18.5 5.5a9 9 0 010 13" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
          </button>
          <div class="opt-grid" id="mqOpts"></div>
          <div class="quiz-feedback" id="mqFb"></div>
        </div>
      </div>
    </section>

    <!-- ===== 识字乐园 ===== -->
    <section class="page" id="page-hanzi">
      <div class="page-head">
        <div>
          <div class="page-title">🀄 识字乐园</div>
          <div class="page-sub">认识常用汉字 3500 个 · 看字形 · 学拼音 · 记词组</div>
        </div>
      </div>
      <div class="card" style="background:linear-gradient(135deg,#FFF1EE,#FFF8F2);border:2px solid #FFD9C9">
        <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap">
          <div style="width:64px;height:64px;border-radius:18px;background:linear-gradient(135deg,#FF8A7A,#F2654F);display:flex;align-items:center;justify-content:center;font-size:34px;font-weight:900;color:#fff;box-shadow:0 4px 12px rgba(242,101,79,.35);flex-shrink:0">字</div>
          <div style="flex:1;min-width:170px">
            <div style="font-weight:900;font-size:18px">我认识 <span id="hzKnown">0</span> 个字</div>
            <div style="height:12px;background:#FFE4D9;border-radius:8px;margin-top:8px;overflow:hidden"><i id="hzBar" style="display:block;height:100%;width:0%;background:linear-gradient(90deg,#FF8A7A,#FFB347);border-radius:8px;transition:width .3s"></i></div>
            <div style="font-size:12px;color:#B57A63;margin-top:6px;font-weight:700">目标：常用字 3500 个 · 每天认识几个，越认越多！</div>
          </div>
          <div style="display:flex;flex-direction:column;gap:8px;width:100%;max-width:200px;margin-left:auto">
            <button class="btn btn-sm" id="hzLearnBtn" style="background:#F2654F">📖 开始认字</button>
            <button class="btn btn-sm btn-ghost" id="hzReviewBtn">🔁 复习已认识</button>
          </div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>
          汉字表
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700" id="hzCount"></span>
        </div>
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:8px">
          <div class="seg" id="hzSeg2">
            <button class="seg-btn active" data-hzg="g1">🌱 启蒙</button>
            <button class="seg-btn" data-hzg="g2">📗 初级</button>
            <button class="seg-btn" data-hzg="g3">📘 中级</button>
            <button class="seg-btn" data-hzg="g4">📙 进阶</button>
          </div>
          <div class="seg" id="hzSeg">
            <button class="seg-btn active" data-hzf="all">全部</button>
            <button class="seg-btn" data-hzf="new">还不认识</button>
            <button class="seg-btn" data-hzf="known">已认识</button>
          </div>
        </div>
        <div class="hz-grid" id="hzGrid"></div>
        <div class="hz-page" id="hzPage"></div>
      </div>
      <!-- 大字学习浮层 -->
      <div class="hz-mask" id="hzMask">
        <div class="hz-pop" id="hzPop"></div>
      </div>
    </section>

    <!-- ===== 古诗花园 ===== -->
    <section class="page" id="page-poems">
      <div class="page-head">
        <div>
          <div class="page-title">📜 古诗花园</div>
          <div class="page-sub">分级诗词古文 · 小学带拼音 · 点朗读按钮听一听</div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3l2 4 4 1-3 3 1 4-4-2-4 2 1-4-3-3 4-1z"/></svg>
          诗词分级
          <span class="chip" style="background:#F5F0FF;color:#8F6FE8" id="poemCount"></span>
          <span class="chip" style="background:#EDFAF1;color:#2E9E62" id="poemDoneCount"></span>
        </div>
        <div class="seg" id="poemSeg" style="margin-bottom:12px">
          <button class="seg-btn active" data-pcat="all">全部</button>
          <button class="seg-btn" data-pcat="xx">🏫 小学</button>
          <button class="seg-btn" data-pcat="cz">📖 初中</button>
          <button class="seg-btn" data-pcat="gz">🎓 高中</button>
          <button class="seg-btn" data-pcat="ts">🌙 唐诗</button>
          <button class="seg-btn" data-pcat="sc">🌊 宋词</button>
          <button class="seg-btn" data-pcat="xd">⭐ 现代</button>
        </div>
        <div class="poem-list" id="poemList"></div>
      </div>
    </section>

    <!-- ===== 数字王国 ===== -->
    <section class="page" id="page-math">
      <div class="page-head">
        <div>
          <div class="page-title">🔢 数字王国</div>
          <div class="page-sub">认识 0-20 · 加减法 · 数数小游戏</div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>
          认识数字 0-20
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700">点一点，听它怎么读</span>
        </div>
        <div class="num-grid" id="numGrid"></div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg>
          加减法小练习
          <span style="display:flex;gap:6px;margin-left:auto" id="mathSeg">
            <button class="seg-btn active" data-d="10">10以内</button>
            <button class="seg-btn" data-d="20">20以内</button>
            <button class="seg-btn" data-d="100">100以内</button>
          </span>
        </div>
        <div class="quiz-box">
          <div class="quiz-score">答对 <span id="arRight">0</span> 题</div>
          <div class="quiz-math-word" id="arQ"></div>
          <div class="opt-grid" id="arOpts"></div>
          <div class="quiz-feedback" id="arFb"></div>
          <button class="btn btn-green btn-sm" id="arNext" style="display:none">下一题 ➡</button>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg>
          数数小游戏
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700">数一数有几个？</span>
        </div>
        <div class="quiz-box">
          <div class="count-game">
            <div class="count-fruits" id="cntFruits"></div>
          </div>
          <div class="quiz-score" style="margin-top:12px">数一数，一共有多少个？</div>
          <div class="opt-grid" id="cntOpts"></div>
          <div class="quiz-feedback" id="cntFb"></div>
        </div>
      </div>
    </section>

    <!-- ===== 逻辑挑战 ===== -->
    <section class="page" id="page-logic">
      <div class="page-head">
        <div>
          <div class="page-title">🧩 逻辑挑战</div>
          <div class="page-sub">找规律 · 图形配对 · 排排序，开动小脑筋</div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg>
          开动小脑筋
          <span class="chip" style="background:#F5F0FF;color:#8F6FE8" id="lgType"></span>
        </div>
        <div class="quiz-box">
          <div class="quiz-score">第 <span id="lgNum">1</span> 题 · 答对 <span id="lgRight">0</span> 题</div>
          <div class="logic-board" id="lgBoard"></div>
          <div class="logic-ask" id="lgAsk"></div>
          <div class="opt-grid" id="lgOpts"></div>
          <div class="quiz-feedback" id="lgFb"></div>
          <button class="btn btn-purple btn-sm" id="lgNext" style="display:none">下一题 ➡</button>
        </div>
      </div>
    </section>

    <!-- ===== 闯关冒险 ===== -->
    <section class="page" id="page-adventure">
      <div class="page-head">
        <div>
          <div class="page-title">🏆 闯关冒险</div>
          <div class="page-sub">闯过每一关，收集星星和徽章！</div>
        </div>
      </div>
      <div class="adv-stats">
        <div class="adv-stat">
          <svg width="26" height="26" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="#FFB347"/></svg>
          <div><div class="v" id="advStars">0</div><div class="l">总星星</div></div>
        </div>
        <div class="adv-stat">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#8F6FE8" stroke-width="2" stroke-linecap="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>
          <div><div class="v" id="advBadges">0</div><div class="l">徽章</div></div>
        </div>
        <div class="adv-stat">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#3E9BE0" stroke-width="2" stroke-linecap="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>
          <div><div class="v" id="advLevels">0</div><div class="l">已通关</div></div>
        </div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>
          关卡地图
          <span style="font-size:12px;color:var(--ink-soft);font-weight:700">点击关卡开始挑战，答对越多星星越多</span>
        </div>
        <div class="level-grid" id="levelGrid"></div>
      </div>
      <div class="card">
        <div class="card-title">
          <svg width="18" height="18" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="#FFB347"/></svg>
          成就徽章墙
        </div>
        <div class="badge-wall" id="badgeWall"></div>
      </div>
    </section>

  </main>
</div>

<!-- ===== 移动端底部 Tab ===== -->
<nav class="bottom-tab" id="bottomTab">
  <button class="bt-btn active" data-page="home"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg>首页</button>
  <button class="bt-btn" data-page="english"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg>英语</button>
  <button class="bt-btn" data-page="hanzi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>识字</button>
  <button class="bt-btn" data-page="poems"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3l2 4 4 1-3 3 1 4-4-2-4 2 1-4-3-3 4-1z"/></svg>古诗</button>
  <button class="bt-btn" data-page="math"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>数字</button>
  <button class="bt-btn" data-page="logic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg>逻辑</button>
  <button class="bt-btn" data-page="adventure"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>闯关</button>
</nav>

<!-- ===== 设置抽屉 ===== -->
<div class="drawer-mask" id="drawerMask"></div>
<div class="drawer" id="drawer">
  <h3>⚙️ 家长设置</h3>
  <p style="font-size:13px;color:var(--ink-soft);margin-bottom:16px">这里是爸爸妈妈的操作区。小朋友想玩的时候，可以点右边的小锁🔒锁上哦～</p>
  <div class="field">
    <label>🔐 家长密码（4 位数字，用于导出/清空数据）</label>
    <input type="password" id="pinInput" inputmode="numeric" maxlength="4" placeholder="默认 0000">
  </div>
  <button class="btn btn-pink" id="btnExport">📦 导出数据备份（JSON）</button>
  <button class="btn btn-blue" id="btnImport">📥 导入恢复数据</button>
  <input type="file" id="importFile" accept=".json" style="display:none">
  <button class="btn btn-yellow" id="btnClearDemo" style="color:#7A5400">🧹 清空示例数据</button>
  <button class="btn btn-ghost" id="btnClearAll">🗑 清空全部数据</button>
  <hr style="border:none;border-top:1px dashed #EED9E8;margin:16px 0">
  <div style="font-size:12px;color:var(--ink-soft);line-height:1.7">
    💡 小提示：<br>
    · 学习数据保存在这台设备的浏览器里，关掉页面也不会丢<br>
    · 换设备前记得先「导出数据」，再在新设备上「导入恢复」<br>
    · 家长密码只是防小朋友误触，不是安全锁
  </div>
</div>

<div id="toast"></div>
<div id="fxLayer"></div>

<script>
'use strict';
/* ================= 数据层 ================= */
var LS_PREFIX = 'wb_xxly_';
function get(k, def){ try{ var v = localStorage.getItem(LS_PREFIX + k); return v ? JSON.parse(v) : def; }catch(e){ return def; } }
function set(k, v){ try{ localStorage.setItem(LS_PREFIX + k, JSON.stringify(v)); }catch(e){ alert('存储空间不足，建议导出备份后清空数据'); } }
function todayStr(){ var d = new Date(), m = ('0'+(d.getMonth()+1)).slice(-2), dd = ('0'+d.getDate()).slice(-2); return d.getFullYear() + '-' + m + '-' + dd; }
function uid(){ return Date.now().toString(36) + Math.random().toString(36).slice(2,7); }

/* ===== 单词库（牛津自然拼读 Phonics World 风格）===== */
