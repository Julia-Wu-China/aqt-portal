function hzWordHTML(w){
  return w.map(function(x){ return '<span class="hz-word" data-sayw="'+escapeHtml(x)+'">'+escapeHtml(x)+'</span>'; }).join('');
}
function renderHanzi(){
  var p = getProgress();
  p.hanziLearned = p.hanziLearned || [];
  var known = p.hanziLearned, knownSet = new Set(known);
  var g = HZ_GROUPS[hzGroup];
  var gKnown = 0;
  HANZI.forEach(function(h, idx){
    if(idx >= g.s && idx < g.e && knownSet.has(h[0])) gKnown++;
  });
  $('hzKnown').textContent = known.length;
  $('hzBar').style.width = Math.round(known.length / HANZI.length * 100) + '%';
  $('hzCount').textContent = g.name + '批 ' + (g.e - g.s) + ' 字 · 已认识 ' + gKnown + ' 字 · 共 ' + HANZI.length + ' 字';
  var list = [];
  HANZI.forEach(function(h, idx){
    if(idx < g.s || idx >= g.e) return;
    if(hzFilter === 'known' && !knownSet.has(h[0])) return;
    if(hzFilter === 'new' && knownSet.has(h[0])) return;
    list.push(h);
  });
  var pages = Math.max(1, Math.ceil(list.length / HZ_PAGE_SIZE));
  if(hzPageN > pages) hzPageN = pages;
  var slice = list.slice((hzPageN-1)*HZ_PAGE_SIZE, hzPageN*HZ_PAGE_SIZE);
  hz.curPage = slice.map(function(h){ return h[0]; });
  $('hzGrid').innerHTML = slice.map(function(h){
    return '<div class="hz-card'+(knownSet.has(h[0])?' known':'')+'" data-hz="'+h[0]+'">'+h[0]+'</div>';
  }).join('');
  $('hzPage').innerHTML =
    '<button class="seg-btn" id="hzPrev"'+(hzPageN<=1?' disabled':'')+'>‹ 上一页</button>'+
    '<span style="font-weight:800;color:var(--ink-soft);font-size:13px">第 '+hzPageN+' / '+pages+' 页</span>'+
    '<button class="seg-btn" id="hzNext"'+(hzPageN>=pages?' disabled':'')+'>下一页 ›</button>';
  var prev = $('hzPrev'), next = $('hzNext');
  if(prev && !prev.disabled) prev.onclick = function(){ hzPageN--; renderHanzi(); };
  if(next && !next.disabled) next.onclick = function(){ hzPageN++; renderHanzi(); };
}
function bindHzPop(){
  var close = $('hzClose');
  if(close) close.onclick = closeHzPop;
  document.querySelectorAll('#hzPop [data-sayw]').forEach(function(el){
    el.onclick = function(){ speak(el.dataset.sayw, 'zh-CN'); };
  });
  var say = $('hzSay');
  if(say) say.onclick = function(){ speak(hz.cur.c || hz.cur[0], 'zh-CN'); };
  var prevCard = $('hzPrevCard');
  if(prevCard && !prevCard.disabled) prevCard.onclick = function(){ hzCardPrevNext(-1); };
  var nextCard = $('hzNextCard');
  if(nextCard && !nextCard.disabled) nextCard.onclick = function(){ hzCardPrevNext(1); };
  var know = $('hzKnow');
  if(know) know.onclick = function(){
    if(hz.mode === 'card'){
      var c = hz.cur.c || hz.cur[0];
      var learned = getProgress().hanziLearned.indexOf(c) !== -1;
      if(learned){
        unmarkHanziLearned(c);
        toast('已取消认识「'+c+'」');
        openHzCard(c);
      } else {
        hzAnswer(true);
      }
    } else if(!know.disabled) {
      hzAnswer(true);
    }
  };
  var no = $('hzNo');
  if(no) no.onclick = function(){ hzAnswer(false); };
}
function openHzPop(){ $('hzMask').classList.add('open'); }
function closeHzPop(){ $('hzMask').classList.remove('open'); hz.mode = null; renderHanzi(); }
function hzGroupRange(){
  var g = HZ_GROUPS[hzGroup];
  var arr = [];
  HANZI.forEach(function(h, idx){ if(idx >= g.s && idx < g.e) arr.push(h); });
  return arr;
}
function startHanziLearn(){
  var p = getProgress(); p.hanziLearned = p.hanziLearned || [];
  var knownSet = new Set(p.hanziLearned);
  var todo = hzGroupRange().filter(function(h){ return !knownSet.has(h[0]); });
  if(todo.length === 0){ toast('🎉 本批字都认识啦！试试切换到下一批～'); return; }
  hz.mode = 'learn'; hz.idx = 0; hz.lock = false;
  hz.list = todo.slice(0, 10);
  openHzPop(); showHzQ();
}
function startHanziReview(){
  var p = getProgress(); p.hanziLearned = p.hanziLearned || [];
  var knownSet = new Set(p.hanziLearned);
  var done = hzGroupRange().filter(function(h){ return knownSet.has(h[0]); });
  if(done.length === 0){ toast('这一批还没有认识的字，先点「开始认字」吧～'); return; }
  hz.mode = 'review'; hz.idx = 0; hz.lock = false;
  hz.list = shuffle(done).slice(0, 10);
  openHzPop(); showHzQ();
}
function showHzQ(){
  var item = hz.list[hz.idx];
  if(!item){
    closeHzPop();
    toast(hz.mode === 'review' ? '✅ 复习完成，记得天天巩固哦！' : '🎉 本轮学完啦！想再学一点就再点「开始认字」～');
    renderHanzi(); renderHome();
    return;
  }
  hz.cur = item;
  $('hzPop').innerHTML =
    '<button class="hz-close" id="hzClose">✕</button>'+
    '<div class="hz-pos">'+(hz.idx+1)+' / '+hz.list.length+(hz.mode==='review'?' · 复习':' · 学新字')+'</div>'+
    '<div class="hz-big">'+item[0]+'</div>'+
    '<div class="hz-py" id="hzPy" style="opacity:0;transition:opacity .3s">'+escapeHtml(item[1])+'</div>'+
    '<div class="hz-words" id="hzWords" style="opacity:0;transition:opacity .3s">'+hzWordHTML(item[2])+'</div>'+
    '<div class="hz-actions">'+
      (hz.mode==='review'
        ? '<button class="btn btn-ghost" disabled style="opacity:.55">📖 复习中</button><button class="btn btn-blue" id="hzSay">🔊 读一读</button>'
        : '<button class="btn btn-green" id="hzKnow">✅ 我认识</button><button class="btn btn-ghost" id="hzNo">📖 还不认识</button>')+
    '</div>'+
    '<div class="hz-tip">'+(hz.mode==='review'?'点「读一读」听发音':'想一想：这个字你认识吗？')+'</div>';
  bindHzPop();
  if(hz.mode === 'review') speak(item[0], 'zh-CN');
}
function hzAnswer(know){
  if(hz.lock) return; hz.lock = true;
  var item = hz.cur;
  var pyEl = $('hzPy'), wEl = $('hzWords');
  if(pyEl) pyEl.style.opacity = 1;
  if(wEl) wEl.style.opacity = 1;
  if(hz.mode === 'card'){
    var wasNew = markHanziLearned(item.c || item[0], true);
    if(wasNew){ confetti(); toast('🎉 认识新字「' + (item.c||item[0]) + '」！'); }
    else{ toast('✓ 这个字你早就会啦！'); }
    speak(item.c || item[0], 'zh-CN');
    openHzCard(item.c || item[0]);
    return;
  }
  var next = function(){ hz.lock = false; hz.idx++; showHzQ(); };
  if(know){
    var isNew = markHanziLearned(item[0], true);
    if(isNew){ confetti(); toast('🎉 认识新字「' + item[0] + '」！'); }
    else{ toast('✓ 这个字你早就会啦！'); }
    speak(item[0], 'zh-CN');
    setTimeout(next, 1400);
  }else{
    toast('没关系，跟着读：「' + item[0] + '」' + item[1]);
    speak(item[0] + '，' + item[2].join('、'), 'zh-CN');
    setTimeout(next, 2200);
  }
}
function openHzCard(c){
  var item = HANZI_MAP[c];
  if(!item) return;
  hz.mode = 'card'; hz.cur = item; hz.lock = false;
  var isK = getProgress().hanziLearned.indexOf(c) !== -1;
  var idx = hz.curPage.indexOf(c);
  var hasPrev = idx > 0;
  var hasNext = idx !== -1 && idx < hz.curPage.length - 1;
  $('hzPop').innerHTML =
    '<button class="hz-close" id="hzClose">✕</button>'+
    '<button class="hz-nav hz-prev" id="hzPrevCard"'+(hasPrev?'':' disabled')+' aria-label="上一个字"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M14.5 5 8 12l6.5 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>'+
    '<button class="hz-nav hz-next" id="hzNextCard"'+(hasNext?'':' disabled')+' aria-label="下一个字"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9.5 5 16 12l-6.5 7" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>'+
    '<div class="hz-pos">点卡片复习</div>'+
    '<div class="hz-big">'+c+'</div>'+
    '<div class="hz-py">'+escapeHtml(item.py)+'</div>'+
    '<div class="hz-words">'+hzWordHTML(item.w)+'</div>'+
    '<div class="hz-actions">'+
      '<button class="btn '+(isK?'btn-ghost':'btn-green')+'" id="hzKnow">'+(isK?'↩ 取消认识':'✅ 我认识')+'</button>'+
      '<button class="btn btn-blue" id="hzSay">🔊 读一读</button>'+
    '</div>'+
    '<div class="hz-tip">'+(isK?'点「取消认识」可撤销':'点词组可以听读音哦～')+'</div>';
  bindHzPop();
  openHzPop();
  speak(c, 'zh-CN');
}
function hzCardPrevNext(dir){
  var c = hz.cur.c || hz.cur[0];
  var idx = hz.curPage.indexOf(c);
  if(idx === -1) return;
  var nextIdx = idx + dir;
  if(nextIdx < 0 || nextIdx >= hz.curPage.length) return;
  openHzCard(hz.curPage[nextIdx]);
}
function markHanziLearned(c, silent){
  var p = getProgress();
  p.hanziLearned = p.hanziLearned || [];
  if(p.hanziLearned.indexOf(c) !== -1) return false;
  p.hanziLearned.push(c);
  var d = getDaily();
  if(d.hanziN < 5) p.stars++;
  d.hanziN++;
  saveProgress(p); saveDaily(d);
  if(!silent){ toast('🎉 认识新字「' + c + '」！'); confetti(); }
  checkAndSync();
  renderHanzi(); renderHome();
  return true;
}
function unmarkHanziLearned(c){
  var p = getProgress();
  p.hanziLearned = p.hanziLearned || [];
  var idx = p.hanziLearned.indexOf(c);
  if(idx === -1) return false;
  p.hanziLearned.splice(idx, 1);
  var d = getDaily();
  if(d.hanziN > 0) d.hanziN--;
  if(p.stars > 0) p.stars--;
  saveProgress(p); saveDaily(d);
  checkAndSync();
  renderHanzi(); renderHome();
  return true;
}
document.querySelectorAll('#poemSeg .seg-btn').forEach(function(el){
  el.addEventListener('click', function(){
    poemCat = el.dataset.pcat;
    document.querySelectorAll('#poemSeg .seg-btn').forEach(function(x){ x.classList.remove('active'); });
    el.classList.add('active');
    renderPoems();
  });
});
$('hzLearnBtn').addEventListener('click', startHanziLearn);
$('hzReviewBtn').addEventListener('click', startHanziReview);
document.querySelectorAll('#hzSeg .seg-btn').forEach(function(el){
  el.addEventListener('click', function(){
    hzFilter = el.dataset.hzf; hzPageN = 1;
    document.querySelectorAll('#hzSeg .seg-btn').forEach(function(x){ x.classList.remove('active'); });
    el.classList.add('active');
    renderHanzi();
  });
});
document.querySelectorAll('#hzSeg2 .seg-btn').forEach(function(el){
  el.addEventListener('click', function(){
    hzGroup = el.dataset.hzg; hzPageN = 1;
    document.querySelectorAll('#hzSeg2 .seg-btn').forEach(function(x){ x.classList.remove('active'); });
    el.classList.add('active');
    renderHanzi();
  });
});


/* ===== 闯关配置 ===== */
var LEVELS = [
 {name:'星星谷'},{name:'彩虹桥'},{name:'糖果镇'},{name:'玩具城'},{name:'森林屋'},
 {name:'海洋湾'},{name:'天空岛'},{name:'火山堡'},{name:'月亮湖'},{name:'星辰宫'}
];
/* ================= 工具 ================= */
function $(id){ return document.getElementById(id); }
function shuffle(a){ a = a.slice(); for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i];a[i]=a[j];a[j]=t; } return a; }
function rand(n){ return Math.floor(Math.random()*n); }
function pick(a){ return a[rand(a.length)]; }
function escapeHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
function toast(msg){ var t=$('toast'); t.textContent=msg; t.classList.add('show'); clearTimeout(t._h); t._h=setTimeout(function(){ t.classList.remove('show'); }, 2000); }
function confetti(){ var fx=$('fxLayer'); for(var i=0;i<18;i++){ var c=document.createElement('div'); c.className='confetti'; c.style.left=(5+Math.random()*90)+'vw'; c.style.background=pick(['#FF9EB5','#6EC6FF','#FFD36E','#7ED9A0','#B79CFF']); c.style.animationDelay=(Math.random()*0.4)+'s'; c.style.transform='rotate('+rand(360)+'deg)'; fx.appendChild(c); setTimeout(function(x){ x.remove(); }, 1800, c); } }
function starBurst(){ var fx=$('fxLayer'); var s=document.createElement('div'); s.className='star-burst'; s.innerHTML='⭐'; fx.appendChild(s); setTimeout(function(){ s.remove(); }, 900); }

/* ===== 语音（Web Speech API）===== */
var voicesCache = [];
function loadVoices(){ try{ voicesCache = window.speechSynthesis ? speechSynthesis.getVoices() : []; }catch(e){} }
if(window.speechSynthesis){ loadVoices(); speechSynthesis.onvoiceschanged = loadVoices; }
function pickVoice(lang){
  var vs = voicesCache.filter(function(v){ return v.lang && v.lang.indexOf(lang) === 0; });
  var pref = vs.filter(function(v){ return /Google|Microsoft|Xiaoxiao|Huihui|Tingting/i.test(v.name); });
  return (pref[0] || vs[0]) || null;
}
function speak(text, lang){
  if(!window.speechSynthesis){ toast('当前浏览器不支持发音'); return; }
  try{ speechSynthesis.cancel(); }catch(e){}
  var u = new SpeechSynthesisUtterance(text);
  u.lang = lang || 'zh-CN';
  u.rate = 0.85;
  var v = pickVoice(u.lang); if(v) u.voice = v;
  speechSynthesis.speak(u);
}
function speakWord(w){ speak(w.en, 'en-US'); }

/* ================= 状态 ================= */
var PROGRESS_KEY = 'progress', DAILY_KEY = 'daily', SETTINGS_KEY = 'settings';
function getProgress(){ var p = get(PROGRESS_KEY); if(!p){ p = seedProgress(); set(PROGRESS_KEY, p); } return p; }
function saveProgress(p){ set(PROGRESS_KEY, p); }
function getSettings(){ var s = get(SETTINGS_KEY); if(!s){ s = { pin:'0000' }; set(SETTINGS_KEY, s); } return s; }
function saveSettings(s){ set(SETTINGS_KEY, s); }

/* 首次预置示例数据：1 关已通 + 2 个已学单词 + 1 首已背诗 + 昨日未完成的任务（逾期示例） */
function seedProgress(){
  var y = new Date(); y.setDate(y.getDate()-1);
  var ys = y.getFullYear()+'-'+('0'+(y.getMonth()+1)).slice(-2)+'-'+('0'+y.getDate()).slice(-2);
  set(DAILY_KEY, { date: ys, words:[{w:'dog',done:false,overdue:true},{w:'pig',done:false,overdue:true},{w:'sun',done:false,overdue:true}], poems:[{id:'p2',done:false,overdue:true}], mathN:3, logicN:0, levelN:0 });
  return { stars:5, levels:{1:{stars:2}}, badges:['first_win'], wordsLearned:['apple','cat'], poemDone:['p1'], mathTotal:8, logicTotal:3, bestCombo:2, hanziLearned:[] };
}

/* 今日任务：昨天未完成的自动顺延到今天 */
function getDaily(){
  var d = get(DAILY_KEY);
  var today = todayStr();
  if(!d || d.date !== today){
    var carryW = d && d.words ? d.words.filter(function(w){ return !w.done; }).map(function(w){ return w.w; }) : [];
    var carryP = d && d.poems ? d.poems.filter(function(p){ return !p.done; }).map(function(p){ return p.id; }) : [];
    var words = [];
    carryW.forEach(function(w){ words.push({w:w, done:false, overdue:true}); });
    var pool = shuffle(ALL_WORDS.map(function(w){ return w.en; }));
    for(var i=0;i<pool.length && words.length<5;i++){ if(!words.some(function(x){ return x.w===pool[i]; })) words.push({w:pool[i], done:false, overdue:false}); }
    var poems = [];
    carryP.forEach(function(id){ poems.push({id:id, done:false, overdue:true}); });
    if(poems.length === 0){ var pid = pick(POEMS).id; poems.push({id:pid, done:false, overdue:false}); }
    d = { date: today, words:words, poems:poems, mathN:0, logicN:0, levelN:0, hanziN:0 };
    set(DAILY_KEY, d);
  }
  d.hanziN = d.hanziN || 0;
  return d;
}
function saveDaily(d){ set(DAILY_KEY, d); }
function progressContains(arr, v){ return arr.indexOf(v) !== -1; }

/* ===== 徽章 ===== */
var BADGES = [
 {id:'first_win', name:'首战告捷', desc:'完成第 1 关', fill:'#FF6B8E'},
 {id:'word_20',  name:'单词小达人', desc:'学会 20 个单词', fill:'#4FA8FF'},
 {id:'poem_5',   name:'古诗小状元', desc:'会背 5 首古诗', fill:'#8F6FE8'},
 {id:'math_20',  name:'算术之星', desc:'做对 20 道算术题', fill:'#5ED08B'},
 {id:'logic_10', name:'逻辑高手', desc:'做对 10 道逻辑题', fill:'#FFC93C'},
 {id:'combo_5',  name:'五连击', desc:'一口气连对 5 题', fill:'#FF7EB0'},
 {id:'fullstar', name:'全星小勇士', desc:'某一关拿满 3 星', fill:'#FFB347'},
 {id:'hanzi_20',  name:'识字小萌新', desc:'认识 20 个汉字', fill:'#FF8A5C'},
 {id:'hanzi_100', name:'识字小能手', desc:'认识 100 个汉字', fill:'#F2654F'},
 {id:'hanzi_500', name:'识字小博士', desc:'认识 500 个汉字', fill:'#D9483C'},
 {id:'hero_5',   name:'探险家', desc:'闯过 5 关', fill:'#3E9BE0'},
 {id:'master',   name:'学习小状元', desc:'通关全部 10 关', fill:'#A98BFF'}
];
function starSVG(fill){ return '<svg width="30" height="30" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="'+(fill||'#C7BBD6')+'"/></svg>'; }
function badgeHTML(b, lit){ return '<div class="badge"><div class="b-ico'+(lit?' lit':'')+'">'+(lit?starSVG(b.fill):'<svg width="26" height="26" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="#E5D9EC"/></svg>')+'</div><div class="b-name">'+b.name+'</div></div>'; }
function checkBadges(p){
  var newBadges = [];
  var defs = [
    ['first_win', p.levels && p.levels[1]],
    ['word_20', p.wordsLearned.length >= 20],
    ['poem_5', p.poemDone.length >= 5],
    ['math_20', p.mathTotal >= 20],
    ['logic_10', p.logicTotal >= 10],
    ['combo_5', p.bestCombo >= 5],
    ['fullstar', Object.keys(p.levels||{}).some(function(k){ return p.levels[k].stars >= 3; })],
    ['hanzi_20', (p.hanziLearned||[]).length >= 20],
    ['hanzi_100', (p.hanziLearned||[]).length >= 100],
    ['hanzi_500', (p.hanziLearned||[]).length >= 500],
    ['hero_5', Object.keys(p.levels||{}).length >= 5],
    ['master', Object.keys(p.levels||{}).length >= 10]
  ];
  defs.forEach(function(d){ if(d[1] && p.badges.indexOf(d[0]) === -1){ p.badges.push(d[0]); newBadges.push(d[0]); } });
  return newBadges;
}

/* ================= 导航 ================= */
var currentPage = 'home';
function switchPage(name){
  currentPage = name;
  document.querySelectorAll('.page').forEach(function(el){ el.classList.toggle('active', el.id === 'page-'+name); });
  document.querySelectorAll('.nav-btn,.bt-btn,.mod-card').forEach(function(el){
    if(el.dataset.page) el.classList.toggle('active', el.dataset.page === name);
  });
  window.scrollTo(0,0);
  if(name==='home') renderHome();
  if(name==='english') renderEnglish();
  if(name==='hanzi') renderHanzi();
  if(name==='poems') renderPoems();
  if(name==='math') renderMath();
  if(name==='logic') newLogicRound();
  if(name==='adventure') renderAdventure();
}
document.querySelectorAll('[data-page]').forEach(function(el){
  el.addEventListener('click', function(){ switchPage(el.dataset.page); });
});

/* ================= 首页 / 今日任务 ================= */
function renderHome(){
  var p = getProgress();
  var d = getDaily();
  $('starTotal').textContent = p.stars;
  $('badgeCount').textContent = p.badges.length;
  $('todayDate').textContent = '今天是 ' + todayStr().replace(/-/g,'.');
  /* 今日任务 */
  var wDone = d.words.filter(function(w){ return progressContains(p.wordsLearned, w.w); }).length;
  var pDone = d.poems.filter(function(po){ return progressContains(p.poemDone, po.id); }).length;
  var mathDone = d.mathN >= 10;
  var hanziDone = d.hanziN >= 10;
  var levelDone = d.levelN >= 1;
  var wOver = d.words.some(function(w){ return w.overdue && !progressContains(p.wordsLearned, w.w); });
  var pOver = d.poems.some(function(po){ return po.overdue && !progressContains(p.poemDone, po.id); });
  function taskHTML(iconBg, iconSVG, name, cur, goal, btnLabel, page, done, overdue, barColor){
    var pct = Math.min(100, Math.round(cur/goal*100));
    return '<div class="task-item'+(done?' done':'')+(overdue?' overdue':'')+'">'+
      '<div class="task-ico" style="background:'+iconBg+'">'+iconSVG+'</div>'+
      '<div class="task-info"><div class="task-name">'+name+'</div>'+
      '<div class="task-bar"><i style="width:'+pct+'%;background:'+barColor+'"></i></div>'+
      '<div class="task-txt">'+(done?'已完成，真棒！':('进度 '+Math.min(cur,goal)+' / '+goal))+'</div></div>'+
      (done ? '<div class="task-btn done">✓</div>' : '<button class="task-btn" data-goto="'+page+'">'+(btnLabel||'去完成')+'</button>')+
      '</div>';
  }
  var icoW='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M4 19V5a2 2 0 012-2h13v16H6a2 2 0 00-2 2z"/><path d="M9 7h6M9 11h6"/></svg>';
  var icoP='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M12 3l2 4 4 1-3 3 1 4-4-2-4 2 1-4-3-3 4-1z"/></svg>';
  var icoM='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg>';
  var icoA='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M12 2l3 6 6 1-4.5 4.5L18 20l-6-3-6 3 1.5-6.5L3 9l6-1z"/></svg>';
  var icoH='<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><rect x="4" y="3" width="16" height="18" rx="3"/><path d="M8 8h8M8 12h8M8 16h5"/></svg>';
  $('todayGrid').innerHTML =
    taskHTML('#FF9EB5', icoW, '学新单词', wDone, 5, '去学', 'english', wDone>=5, wOver, 'linear-gradient(90deg,#FF9EB5,#FF6B8E)') +
    taskHTML('#B79CFF', icoP, '会背古诗', pDone, 1, '去背', 'poems', pDone>=1, pOver, 'linear-gradient(90deg,#B79CFF,#8F6FE8)') +
    taskHTML('#7ED9A0', icoM, '算术小练', d.mathN, 10, '去算', 'math', mathDone, false, 'linear-gradient(90deg,#7ED9A0,#4BBE7B)') +
    taskHTML('#FF8A7A', icoH, '认新汉字', d.hanziN, 10, '去认', 'hanzi', hanziDone, false, 'linear-gradient(90deg,#FF8A7A,#F2654F)') +
    taskHTML('#6EC6FF', icoA, '闯关冒险', d.levelN, 1, '去闯', 'adventure', levelDone, false, 'linear-gradient(90deg,#6EC6FF,#3E9BE0)');
  /* 首页徽章 */
  $('homeBadges').innerHTML = BADGES.map(function(b){ return badgeHTML(b, p.badges.indexOf(b.id) !== -1); }).join('');
  /* 星星统计 */
  renderStarPanel(p);
}
function renderStarPanel(p){
  $('starTotal').textContent = p.stars;
  $('advStars').textContent = p.stars;
  $('advBadges').textContent = p.badges.length;
  $('advLevels').textContent = Object.keys(p.levels||{}).length;
}
document.addEventListener('click', function(e){
  var g = e.target.closest('[data-goto]');
  if(g){ switchPage(g.dataset.goto); }
});

/* ================= 英语乐园 ================= */
var curBook = 0;
var mq = { idx:0, right:0, cur:null, answered:false, total:5 };
function renderEnglish(){
  renderBookSeg();
  renderWords();
  newMatchQ();
}
function renderBookSeg(){
  var groups = [
    {title:'📖 分级词汇', books:[]},
    {title:'🏷️ 常用分类', books:[]}
  ];
  WORD_BOOKS.forEach(function(b, i){
    if(b.name.indexOf('Level') === 0) groups[0].books.push({b:b, i:i});
    else groups[1].books.push({b:b, i:i});
  });
  $('bookSeg').innerHTML = groups.map(function(g){
    return '<div class="book-group">' +
      '<div class="book-group-title">' + g.title + '</div>' +
      '<div class="book-group-tags">' +
      g.books.map(function(item){
        return '<button class="seg-btn'+(item.i===curBook?' active':'')+'" data-book="'+item.i+'" style="'+(item.i===curBook?'background:'+item.b.color+';color:#fff':'')+'">'+item.b.name+'</button>';
      }).join('') +
      '</div></div>';
  }).join('');
  document.querySelectorAll('[data-book]').forEach(function(el){
    el.addEventListener('click', function(){ curBook = parseInt(el.dataset.book); renderBookSeg(); renderWords(); });
  });
}
function renderWords(){
  var p = getProgress();
  var words = WORD_BOOKS[curBook].words;
  var learnedN = 0;
  $('wordGrid').innerHTML = words.map(function(w){
    var isL = progressContains(p.wordsLearned, w.en);
    if(isL) learnedN++;
    return '<div class="word-card'+(isL?' learned':'')+'" data-w="'+escapeHtml(w.en)+'">'+
      (w.type==='sight'?'<span class="w-tag">视觉词</span>':'')+
      '<div class="w-pic">'+w.pic+'</div>'+
      '<div class="w-en">'+escapeHtml(w.en)+'</div>'+
      '<div class="w-phone">'+escapeHtml(w.phone)+'</div>'+
      '<div class="w-cn">'+escapeHtml(w.cn)+'</div>'+
      '<div class="w-check">'+(isL?'✓ 学会啦':'点卡片听发音')+'</div></div>';
  }).join('');
  var total = ALL_WORDS.length;
  $('wordCount').textContent = '已学会 ' + p.wordsLearned.length + ' / ' + total + ' 个单词';
  document.querySelectorAll('#wordGrid .word-card').forEach(function(card){
    card.addEventListener('click', function(){
      var en = card.dataset.w;
      var w = ALL_WORDS.filter(function(x){ return x.en === en; })[0];
      if(!w) return;
      speakWord(w);
      card.classList.remove('learned');
      void card.offsetWidth;
      card.classList.add('learned');
      setTimeout(function(){ if(!progressContains(getProgress().wordsLearned, en)) card.classList.remove('learned'); }, 900);
    });
  });
}
function markWordLearned(en, silent){
  var p = getProgress();
  if(progressContains(p.wordsLearned, en)) return;
  p.wordsLearned.push(en);
  saveProgress(p);
  var d = getDaily();
  d.words.forEach(function(w){ if(w.w === en) w.done = true; });
  saveDaily(d);
  if(!silent){ toast('🎉 学会新单词：' + en + '！'); confetti(); }
  checkAndSync();
  renderWords();
  renderHome();
}
function newMatchQ(){
  var target = pick(ALL_WORDS);
  var opts = shuffle([target].concat(shuffle(ALL_WORDS.filter(function(w){ return w.en !== target.en; })).slice(0,3)));
  mq.cur = { target: target, opts: opts };
  mq.answered = false;
  $('mqNum').textContent = Math.min(mq.idx+1, mq.total);
  $('mqRight').textContent = mq.right;
  $('mqFb').textContent = '';
  $('mqOpts').innerHTML = opts.map(function(w){
    return '<button class="opt-btn" data-mq="'+escapeHtml(w.en)+'"><span style="font-size:30px">'+w.pic+'</span><span>'+escapeHtml(w.en)+'</span></button>';
  }).join('');
  setTimeout(function(){ speakWord(mq.cur.target); }, 300);
}
$('mqSay').addEventListener('click', function(){ if(mq.cur) speakWord(mq.cur.target); });
$('mqOpts').addEventListener('click', function(e){
  var b = e.target.closest('[data-mq]');
  if(!b || mq.answered) return;
  var en = b.dataset.mq;
  mq.answered = true;
  if(en === mq.cur.target.en){
    b.classList.add('correct');
    mq.right++;
    markWordLearned(en, true);
    $('mqFb').innerHTML = '<span style="color:#2E9E62">🎉 太棒啦！答对啦！</span>';
    confetti();
    mq.idx++;
    if(mq.idx >= mq.total){
      $('mqFb').innerHTML = '<span style="color:#2E9E62;font-size:17px">🌟 这局答对 ' + mq.right + ' / ' + mq.total + ' 题！</span>';
      $('mqOpts').innerHTML = '<button class="btn btn-pink" id="mqAgain" style="margin:6px auto">再来一局 🎮</button>';
      $('mqAgain').addEventListener('click', function(){ mq.idx = 0; mq.right = 0; newMatchQ(); });
      return;
    }
    setTimeout(newMatchQ, 900);
  }else{
    b.classList.add('wrong');
    $('mqFb').innerHTML = '<span style="color:#E0557B">再听一听，找一找～</span>';
    speakWord(mq.cur.target);
    setTimeout(function(){ b.classList.remove('wrong'); mq.answered = false; }, 900);
  }
});

/* ================= 古诗花园 ================= */
function renderPoems(){
  var p = getProgress();
  var list = POEMS.filter(function(po){ return poemCat === 'all' || po.cat === poemCat; });
  var doneIn = list.filter(function(po){ return progressContains(p.poemDone, po.id); });
  $('poemCount').textContent = '精选 ' + list.length + ' 首';
  $('poemDoneCount').textContent = '已会背 ' + doneIn.length + ' 首';
  $('poemList').innerHTML = list.map(function(po){
    var isD = progressContains(p.poemDone, po.id);
    var catTag = '<span class="poem-cat" style="font-size:11px;font-weight:800;padding:1px 8px;border-radius:8px;background:'+(po.cat==='xx'?'#EDFAF1;color:#2E9E62':po.cat==='cz'?'#EAF3FF;color:#3E9BE0':po.cat==='gz'?'#FFF3E2;color:#E8954E':po.cat==='ts'?'#F5F0FF;color:#8F6FE8':po.cat==='sc'?'#EAFBF6;color:#2BA98A':'#FFF0F5;color:#E05A8E')+'">'+(POEM_CAT_NAME[po.cat]||po.cat)+'</span>';
    return '<div class="poem-card'+(isD?' done':'')+'" data-pid="'+po.id+'">'+
      '<button class="say-btn small" data-say="'+po.id+'"><svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M3 9v6h4l5 5V4L7 9H3z"/><path d="M16 8a5 5 0 010 8M18.5 5.5a9 9 0 010 13" stroke="#fff" stroke-width="2" fill="none" stroke-linecap="round"/></svg></button>'+
      '<div class="poem-title">'+escapeHtml(po.t)+catTag+'</div>'+
      '<div class="poem-author">【'+escapeHtml(po.a)+'】</div>'+
      '<div class="poem-lines">'+po.l.map(function(x){ return escapeHtml(x[0])+(x[1]?'<span class="py">'+escapeHtml(x[1])+'</span>':''); }).join('<br>')+'</div>'+
      '<button class="btn btn-sm '+(isD?'btn-ghost':'btn-purple')+'" data-done="'+po.id+'" style="margin-top:12px">'+(isD?'✓ 我会背了':'背会啦，点我标记')+'</button>'+
      '</div>';
  }).join('');
  document.querySelectorAll('[data-say]').forEach(function(el){
    el.addEventListener('click', function(){
      var po = POEMS.filter(function(x){ return x.id === el.dataset.say; })[0];
      if(!po) return;
      speak(po.t + '，' + po.a + '。' + po.l.map(function(x){ return x[0]; }).join('。') + '。', 'zh-CN');
    });
  });
  document.querySelectorAll('[data-done]').forEach(function(el){
    el.addEventListener('click', function(){
      var p = getProgress();
      var id = el.dataset.done;
      var idx = p.poemDone.indexOf(id);
      var d = getDaily();
      if(idx === -1){
        p.poemDone.push(id);
        d.poems.forEach(function(po){ if(po.id === id) po.done = true; });
        toast('📜 会背一首新古诗，真棒！');
        confetti();
      }else{
        p.poemDone.splice(idx, 1);
        d.poems.forEach(function(po){ if(po.id === id) po.done = false; });
      }
      saveProgress(p); saveDaily(d);
      checkAndSync();
      renderPoems(); renderHome();
    });
  });
}

/* ================= 数字王国 ================= */
var CN_NUM = ['零','一','二','三','四','五','六','七','八','九','十','十一','十二','十三','十四','十五','十六','十七','十八','十九','二十'];
var EN_NUM = ['zero','one','two','three','four','five','six','seven','eight','nine','ten','eleven','twelve','thirteen','fourteen','fifteen','sixteen','seventeen','eighteen','nineteen','twenty'];
function renderMath(){ renderNums(); newAr(); newCnt(); }
function renderNums(){
  $('numGrid').innerHTML = Array.from({length:21}, function(_, n){
    var dots = '';
    if(n <= 20){
      for(var i=0;i<Math.min(n, 12);i++){ dots += '<span class="dot"></span>'; }
    }
    return '<div class="num-card" data-n="'+n+'"><div class="n-big">'+n+'</div><div class="n-en">'+EN_NUM[n]+'</div><div class="n-dots">'+dots+'</div></div>';
  }).join('');
  document.querySelectorAll('#numGrid .num-card').forEach(function(card){
    card.addEventListener('click', function(){
      var n = parseInt(card.dataset.n);
      speak(CN_NUM[n], 'zh-CN');
      setTimeout(function(){ speak(EN_NUM[n], 'en-US'); }, 1200);
    });
  });
}
/* 加减法 */
var arDiff = 10, arRight = 0;
function arLevel(max){
  var a = 1 + rand(max), b = 1 + rand(max);
  var add = Math.random() < 0.5;
  if(add){
    var sum = a + b;
    if(sum > max){ sum = max - rand(max); if(sum < 2) sum = 2; a = 1 + rand(sum-1); b = sum - a; }
    return { q: a + ' + ' + b + ' = ?', a: sum };
  }else{
    if(b >= a){ b = rand(a); }
    return { q: a + ' - ' + b + ' = ?', a: a - b };
  }
}
function newAr(){
  var t = arLevel(arDiff);
  var opts = shuffle([t.a].concat(uniqueOpts(t.a, arDiff)));
  $('arQ').textContent = t.q;
  $('arFb').textContent = '';
  $('arNext').style.display = 'none';
  $('arOpts').innerHTML = opts.map(function(n){
    return '<button class="opt-btn" data-ar="'+n+'">'+n+'</button>';
  }).join('');
  $('arRight').textContent = arRight;
}
function uniqueOpts(ans, max){
  var s = new Set([ans]); var out = [];
  var guard = 0;
  while(out.length < 3 && guard < 50){
    guard++;
    var v = rand(max + 1);
    if(!s.has(v)){ s.add(v); out.push(v); }
  }
  return out;
}
$('arOpts').addEventListener('click', function(e){
  var b = e.target.closest('[data-ar]');
  if(!b || $('arNext').style.display !== 'none') return;
  var picked = parseInt(b.dataset.ar);
  var q = $('arQ').textContent;
  var expr = q.replace('= ?','').trim();
  var correct = eval(expr);
  if(picked === correct){
    b.classList.add('correct');
    arRight++;
    $('arRight').textContent = arRight;
    $('arFb').innerHTML = '<span style="color:#2E9E62">✅ 答对啦！</span>';
    var p = getProgress(); p.mathTotal++; saveProgress(p);
    var d = getDaily(); d.mathN++; saveDaily(d);
    checkAndSync(); renderHome();
    confetti();
    if(d.mathN === 10){ starBurst(); }
  }else{
    b.classList.add('wrong');
    $('arFb').innerHTML = '<span style="color:#E0557B">正确答案是 ' + correct + '，再试试下一题吧～</span>';
    document.querySelectorAll('[data-ar]').forEach(function(x){ if(parseInt(x.dataset.ar) === correct) x.classList.add('correct'); });
  }
  $('arNext').style.display = 'inline-flex';
});
$('arNext').addEventListener('click', newAr);
document.querySelectorAll('#mathSeg .seg-btn').forEach(function(el){
  el.addEventListener('click', function(){
    arDiff = parseInt(el.dataset.d);
    document.querySelectorAll('#mathSeg .seg-btn').forEach(function(x){ x.classList.remove('active'); x.style.background=''; x.style.color=''; });
    el.classList.add('active'); el.style.background='#4BBE7B'; el.style.color='#fff';
    newAr();
  });
});
/* 数数游戏 */
var FRUITS = ['🍎','🍓','🍇','🍊','🍋','🍉','🍑','🍒'];
var cntQ = null;
function newCnt(){
  var n = 5 + rand(16);
  var fruits = '';
  for(var i=0;i<n;i++){ fruits += pick(FRUITS); }
  cntQ = n;
  $('cntFruits').textContent = fruits;
  $('cntFb').textContent = '';
  var opts = shuffle(uniqueOpts(n, 25).concat([n]));
  $('cntOpts').innerHTML = opts.map(function(v){
    return '<button class="opt-btn" data-cnt="'+v+'">'+v+'</button>';
  }).join('');
}
$('cntOpts').addEventListener('click', function(e){
  var b = e.target.closest('[data-cnt]');
  if(!b || $('cntFb').textContent) return;
  var v = parseInt(b.dataset.cnt);
  if(v === cntQ){
    b.classList.add('correct');
    $('cntFb').innerHTML = '<span style="color:#2E9E62">✅ 数得真准！一共 ' + cntQ + ' 个！</span>';
    confetti();
    setTimeout(newCnt, 1200);
  }else{
    b.classList.add('wrong');
    $('cntFb').innerHTML = '<span style="color:#E0557B">再数一数哦～</span>';
    setTimeout(function(){ b.classList.remove('wrong'); }, 900);
  }
});

/* ================= 逻辑挑战 ================= */
var SHAPES = ['circle','tri','sq','star','heart','dia'];
var COLORS = ['#FF6B8E','#4FA8FF','#FFC93C','#5ED08B','#A98BFF'];
function shapeSVG(t, c, s){
  s = s || 46;
  var svg = '';
  if(t==='circle'){ svg = '<circle cx="'+(s/2)+'" cy="'+(s/2)+'" r="'+(s/2-4)+'" fill="'+c+'"/>'; }
  else if(t==='tri'){ svg = '<polygon points="'+(s/2)+','+4+' '+(s-4)+','+(s-4)+' '+4+','+(s-4)+'" fill="'+c+'"/>'; }
  else if(t==='sq'){ svg = '<rect x="6" y="6" width="'+(s-12)+'" height="'+(s-12)+'" rx="6" fill="'+c+'"/>'; }
  else if(t==='star'){ var pts=''; for(var i=0;i<10;i++){ var r = i%2===0 ? s/2-2 : s/2-12; var a = Math.PI/5*i - Math.PI/2; pts += (s/2 + r*Math.cos(a)).toFixed(1)+','+(s/2 + r*Math.sin(a)).toFixed(1)+' '; } svg = '<polygon points="'+pts+'" fill="'+c+'"/>'; }
  else if(t==='heart'){ svg = '<path d="M'+(s/2)+' '+(s-6)+' C'+(s/2-s/2.4)+' '+(s/2)+' '+6+' '+(s/2-8)+' '+(s/2)+' 14 C'+(s-6)+' '+(s/2-8)+' '+(s/2+s/2.4)+' '+(s/2)+' '+(s/2)+' '+(s-6)+'z" fill="'+c+'"/>'; }
  else if(t==='dia'){ svg = '<polygon points="'+(s/2)+',4 '+(s-4)+','+(s/2)+' '+(s/2)+','+(s-4)+' 4,'+(s/2)+'" fill="'+c+'"/>'; }
  return '<svg class="shape" width="'+s+'" height="'+s+'" viewBox="0 0 '+s+' '+s+'">'+svg+'</svg>';
}
var lg = { idx:0, right:0, cur:null, total:5 };
function newLogicRound(){
  lg.idx = 0; lg.right = 0;
  lg.cur = null;
  $('lgRight').textContent = 0;
  $('lgNext').style.display = 'none';
  nextLogicQ();
}
function genLogicQ(){
  var kind = pick(['pattern','pattern','match','sort']);
  if(kind === 'pattern'){
    var type = pick(['color','shape','num']);
    if(type === 'num'){
      var diff = pick([1,2,3,5,10]);
      var start = 1 + rand(5);
      var seq = [start, start+diff, start+diff*2, start+diff*3];
      var ans = start + diff*4;
      var optVals = uniqueOpts(ans, 60); optVals.push(ans); optVals = shuffle(optVals);
      return { kind:'pattern', board: seq.map(function(n){ return '<div class="shape" style="width:44px;height:44px;border-radius:12px;background:#A98BFF;color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900">'+n+'</div>'; }).join('') + '<div class="shape" style="width:44px;height:44px;border-radius:12px;background:#fff;border:3px dashed #A98BFF;display:flex;align-items:center;justify-content:center;font-size:22px;font-weight:900;color:#A98BFF">?</div>', ask:'按规律想一想，下一个数字是几？', opts:optVals.map(function(v){ return { v:v, html:String(v) }; }), a:ans };
    }
    var s = pick(SHAPES), c = pick(COLORS);
    var c2 = pick(COLORS.filter(function(x){ return x !== c; }));
    var t2 = pick(SHAPES.filter(function(x){ return x !== s; }));
    var seq = [], ans = null;
    if(type === 'color'){
      seq = [s+'|'+c, s+'|'+c2, s+'|'+c, s+'|'+c2];
      ans = s + '|' + c;
    }else{
      seq = [s+'|'+c, t2+'|'+c, s+'|'+c, t2+'|'+c];
      ans = s + '|' + c;
    }
    var cands = [];
    SHAPES.forEach(function(sh){ COLORS.forEach(function(co){ if(sh+'|'+co !== ans) cands.push(sh+'|'+co); }); });
    var optVals = shuffle([ans].concat(shuffle(cands).slice(0,3)));
    return { kind:'pattern', board: seq.map(function(x){ var p=x.split('|'); return shapeSVG(p[0],p[1]); }).join('') + '<div style="width:46px;height:46px;border-radius:12px;background:#fff;border:3px dashed #B79CFF;display:flex;align-items:center;justify-content:center;font-weight:900;color:#B79CFF;font-size:22px">?</div>', ask:'找一找规律，下一个是什么？', opts:optVals.map(function(x){ var p=x.split('|'); return { v:x, html:shapeSVG(p[0],p[1]) }; }), a:ans };
  }
  if(kind === 'match'){
    var s = pick(SHAPES), c = pick(COLORS);
    var target = s + '|' + c;
    var cands = [];
    SHAPES.forEach(function(sh){ COLORS.forEach(function(co){ if(sh+'|'+co !== target) cands.push(sh+'|'+co); }); });
    var optVals = shuffle([target].concat(shuffle(cands).slice(0,3)));
    return { kind:'match', board:'<div style="text-align:center">找出和它一模一样的图形👇</div>' + shapeSVG(s, c, 64), ask:'哪个和它一模一样？', opts:optVals.map(function(x){ var p=x.split('|'); return { v:x, html:shapeSVG(p[0],p[1]) }; }), a:target };
  }
  /* sort */
  var n1 = 1 + rand(18), n2 = 1 + rand(18), n3 = 1 + rand(18);
  while(n2 === n1){ n2 = 1 + rand(18); } while(n3 === n1 || n3 === n2){ n3 = 1 + rand(18); }
  var nums = [n1,n2,n3];
  var sorted = nums.slice().sort(function(a,b){ return a-b; });
  var perms = [sorted.join(',')];
  var guard = 0;
  while(perms.length < 4 && guard < 40){
    guard++;
    var pm = shuffle(nums).join(',');
    if(perms.indexOf(pm) === -1) perms.push(pm);
  }
  perms = shuffle(perms);
  return { kind:'sort', board: nums.map(function(n){ return '<span class="shape" style="width:52px;height:52px;border-radius:14px;background:#FFF3D6;border:2px solid #FFD36E;display:inline-flex;align-items:center;justify-content:center;font-size:24px;font-weight:900;color:#C77E00">'+n+'</span>'; }).join(''), ask:'把这三个数字从小到大排一排：', opts:perms.map(function(x){ return { v:x, html:x.split(',').join('  →  ') }; }), a:sorted.join(',') };
}
function nextLogicQ(){
  lg.idx++;
  lg.cur = genLogicQ();
  $('lgNum').textContent = lg.idx;
  $('lgFb').textContent = '';
  $('lgNext').style.display = 'none';
  var q = lg.cur;
  $('lgType').textContent = q.kind === 'pattern' ? '找规律' : (q.kind === 'match' ? '图形配对' : '排排序');
  $('lgBoard').innerHTML = q.board;
  $('lgAsk').textContent = q.ask;
  $('lgOpts').innerHTML = q.opts.map(function(o, i){
    return '<button class="opt-btn" data-lgo="'+i+'">'+o.html+'</button>';
  }).join('');
}
$('lgOpts').addEventListener('click', function(e){
  var b = e.target.closest('[data-lgo]');
  if(!b || $('lgNext').style.display !== 'none') return;
  var i = parseInt(b.dataset.lgo);
  var q = lg.cur;
  if(q.opts[i].v === q.a){
    b.classList.add('correct'); lg.right++; $('lgRight').textContent = lg.right;
    $('lgFb').innerHTML = '<span style="color:#2E9E62">✅ 真聪明！</span>'; confetti();
    var p = getProgress(); p.logicTotal++; saveProgress(p);
    var d = getDaily(); d.logicN++; saveDaily(d);
    checkAndSync(); renderHome();
  }else{
    b.classList.add('wrong');
    q.opts.forEach(function(o, j){ if(o.v === q.a && j !== i) document.querySelectorAll('[data-lgo]')[j].classList.add('correct'); });
    $('lgFb').innerHTML = '<span style="color:#E0557B">再想想，看看绿色标记的答案～</span>';
  }
  $('lgNext').style.display = 'inline-flex';
});
$('lgNext').addEventListener('click', function(){
  if(lg.idx >= lg.total){
    $('lgFb').innerHTML = '<span style="color:#8F6FE8;font-size:17px">🌟 本局完成！答对 ' + lg.right + ' / ' + lg.total + ' 题</span>';
    $('lgNext').textContent = '再来一局 🔄';
    $('lgNext').onclick = function(){ $('lgNext').textContent = '下一题 ➡'; newLogicRound(); };
    return;
  }
  nextLogicQ();
});
/*LOGIC*/

/* ================= 闯关冒险 ================= */
var adv = { level:0, idx:0, right:0, qs:[], playing:false };
function renderAdventure(){
  var p = getProgress();
  renderStarPanel(p);
  $('levelGrid').innerHTML = LEVELS.map(function(lv, i){
    var n = i + 1;
    var got = p.levels[n] ? p.levels[n].stars : 0;
    var unlocked = n === 1 || p.levels[n-1];
    var stars = '';
    for(var s=1;s<=3;s++){ stars += '<svg width="20" height="20" viewBox="0 0 24 24"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="'+(s<=got?'#FFB347':'#E5D9EC')+'"/></svg>'; }
    return '<div class="level-card'+(unlocked?'':' locked')+'" data-lv="'+n+'" style="'+(unlocked?'border-color:'+['#FF9EB5','#6EC6FF','#FFD36E','#7ED9A0','#B79CFF'][n % 5] :'')+'">'+
      '<div class="lv-num">第 ' + n + ' 关</div><div class="lv-name">' + lv.name + '</div>'+
      '<div class="level-stars">' + stars + '</div>'+
      '<div class="task-txt">' + (got ? '已通关' : (unlocked ? '点击挑战' : '先通过上一关')) + '</div></div>';
  }).join('');
  document.querySelectorAll('[data-lv]').forEach(function(el){
    el.addEventListener('click', function(){
      var n = parseInt(el.dataset.lv);
      if(el.classList.contains('locked')){ toast('先通关上一关，才能解锁哦～'); return; }
      startLevel(n);
    });
  });
  renderBadgeWall(p);
}
function renderBadgeWall(p){
  $('badgeWall').innerHTML = BADGES.map(function(b){ return badgeHTML(b, p.badges.indexOf(b.id) !== -1); }).join('');
}
function genAdvQ(level){
  var kind = pick(['math','en','poem','logic','hanzi','math','en']);
  if(kind === 'math'){
    var max = level <= 2 ? 10 : (level <= 5 ? 20 : 100);
    var t = arLevel(max);
    return { kind:'math', q:t.q, a:t.a, opts:shuffle(uniqueOpts(t.a, max).concat([t.a])).map(function(v){ return { v:v, html:String(v) }; }) };
  }
  if(kind === 'hanzi'){
    var h = pick(HANZI);
    return { kind:'hanzi', q:'「' + h[0] + '」的拼音是哪个？', a:h[1], opts:shuffle([h[1]].concat(hzDistractors(h[1]))).map(function(py){ return { v:py, html:py }; }) };
  }
  if(kind === 'en'){
    var w = pick(ALL_WORDS);
    var opts = shuffle([w].concat(shuffle(ALL_WORDS.filter(function(x){ return x.en !== w.en; })).slice(0,3)));
    return { kind:'en', q:'「' + w.cn + '」用英语怎么说？', a:w.en, opts:opts.map(function(x){ return { v:x.en, html:x.en }; }) };
  }
  if(kind === 'poem'){
    var po = pick(POEMS);
    var li = rand(po.l.length);
    var line = po.l[li][0];
    var others = shuffle(POEMS.filter(function(x){ return x.t !== po.t; })).slice(0,3).map(function(x){ return x.t; });
    var opts = shuffle([po.t].concat(others));
    return { kind:'poem', q:'「' + line + '」是哪首古诗里的句子？', a:po.t, opts:opts.map(function(x){ return { v:x, html:x }; }) };
  }
  var lq = genLogicQ();
  return { kind:'logic', q:lq.ask, a:lq.a, opts:lq.opts, board:lq.board };
}
function startLevel(n){
  adv.level = n; adv.idx = 0; adv.right = 0; adv.streak = 0; adv.playing = true;
  adv.qs = [];
  for(var i=0;i<5;i++){ adv.qs.push(genAdvQ(n)); }
  var wrap = $('levelGrid').closest('.card');
  wrap.style.display = 'none';
  var advBox = $('advBox') || (function(){
    var div = document.createElement('div');
    div.id = 'advBox';
    div.className = 'quiz-box';
    div.innerHTML = '<div class="quiz-score" id="advInfo"></div><div class="adv-progress"><i id="advBar" style="width:0%"></i></div><div class="quiz-math-word" id="advQ"></div><div class="logic-board" id="advBoard" style="display:none"></div><div class="opt-grid" id="advOpts"></div><div class="quiz-feedback" id="advFb"></div><div style="display:flex;gap:10px;justify-content:center;margin-top:12px"><button class="btn btn-ghost btn-sm" id="advExit">返回地图</button></div>';
    $('page-adventure').insertBefore(div, wrap.nextSibling);
    $('advExit').addEventListener('click', function(){ endLevelView(); });
    return div;
  })();
  renderAdvQ();
  window.scrollTo(0, 0);
}
function renderAdvQ(){
  var q = adv.qs[adv.idx];
  $('advInfo').textContent = '第 ' + adv.level + ' 关 · 第 ' + (adv.idx+1) + ' / 5 题 · 已答对 ' + adv.right + ' 题';
  $('advBar').style.width = ((adv.idx)/5*100) + '%';
  $('advQ').textContent = q.q;
  $('advFb').textContent = '';
  var board = $('advBoard');
  if(q.board){ board.style.display = 'flex'; board.innerHTML = q.board; } else { board.style.display = 'none'; }
  $('advOpts').innerHTML = q.opts.map(function(o, i){
    return '<button class="opt-btn" data-ado="'+i+'">'+o.html+'</button>';
  }).join('');
}
$('page-adventure').addEventListener('click', function(e){
  var b = e.target.closest('[data-ado]');
  if(!b || !$('advOpts') || $('advFb').dataset.lock === '1') return;
  var i = parseInt(b.dataset.ado);
  var q = adv.qs[adv.idx];
  var isOk = (q.opts[i].v === q.a);
  $('advFb').dataset.lock = '1';
  if(isOk){
    b.classList.add('correct');
    adv.right++; adv.streak++;
    var p0 = getProgress();
    if(adv.streak > p0.bestCombo){ p0.bestCombo = adv.streak; saveProgress(p0); checkAndSync(); }
    confetti();
    $('advFb').innerHTML = '<span style="color:#2E9E62">✅ 答对啦！</span>';
  }else{
    b.classList.add('wrong');
    adv.streak = 0;
    document.querySelectorAll('[data-ado]').forEach(function(x){
      var j = parseInt(x.dataset.ado);
      if(q.opts[j].v === q.a) x.classList.add('correct');
    });
    $('advFb').innerHTML = '<span style="color:#E0557B">正确答案：' + escapeHtml(String(q.a)) + '</span>';
  }
  setTimeout(function(){
    adv.idx++;
    delete $('advFb').dataset.lock;
    if(adv.idx >= 5){ finishLevel(); }
    else renderAdvQ();
  }, 1100);
});
function finishLevel(){
  var p = getProgress();
  var n = adv.level;
  var stars = adv.right === 5 ? 3 : (adv.right >= 3 ? 2 : (adv.right >= 1 ? 1 : 0));
  var old = p.levels[n] ? p.levels[n].stars : 0;
  var isNew = !p.levels[n];
  var gained = stars - old;
  if(gained > 0){ p.levels[n] = { stars: Math.max(old, stars) }; p.stars += gained; }
  if(stars > 0 && isNew){
    var d = getDaily(); d.levelN++; saveDaily(d);
  }
  saveProgress(p);
  var newB = checkBadges(p);
  if(newB.length){ saveProgress(p); toast('🏅 获得新徽章！'); }
  if(gained > 0) saveProgress(p);
  /* 结算界面 */
  var starsHTML = '';
  for(var s=1;s<=3;s++){ starsHTML += '<svg width="44" height="44" viewBox="0 0 24 24" style="margin:0 4px"><path d="M12 2l2.4 5.2L20 8l-4 4 1 6-5-3-5 3 1-6-4-4 5.6-.8z" fill="'+(s<=stars?'#FFB347':'#E5D9EC')+'"/></svg>'; }
  $('advBar').style.width = '100%';
  $('advQ').textContent = '';
  $('advBoard').style.display = 'none';
  $('advOpts').innerHTML = '';
  $('advInfo').textContent = '第 ' + n + ' 关挑战完成！';
  $('advFb').innerHTML = '<div style="font-size:17px;font-weight:900;margin-bottom:6px">答对 ' + adv.right + ' / 5 题</div><div style="display:flex;justify-content:center;align-items:center">' + starsHTML + '</div>' +
    (stars === 0 ? '<div style="color:#E0557B;margin-top:8px">再试一次，你一定能闯过去！</div>' : '<div style="color:#2E9E62;margin-top:8px">' + (gained > 0 ? '太棒了！收获 ' + gained + ' 颗星星！' : '继续保持，星星已是你的！') + '</div>') +
    '<div style="display:flex;gap:10px;justify-content:center;margin-top:14px;flex-wrap:wrap">' +
    '<button class="btn btn-purple" id="advAgain">再来一次</button>' +
    '<button class="btn btn-blue" id="advNextLv">' + (n < 10 && p.levels[n] ? '下一关 ➡' : '返回地图') + '</button></div>';
  $('advAgain').addEventListener('click', function(){ startLevel(n); });
  $('advNextLv').addEventListener('click', function(){ if(n < 10 && p.levels[n]){ startLevel(n+1); } else { endLevelView(); renderAdventure(); } });
  if(stars > 0 && isNew){ starBurst(); }
  checkAndSync();
}
function endLevelView(){
  var advBox = $('advBox'); if(advBox) advBox.remove();
  var wrap = $('levelGrid').closest('.card'); wrap.style.display = '';
  adv.playing = false;
  renderAdventure();
}

/* ===== 成就 / 数据同步 ===== */
function checkAndSync(){
  var p = getProgress();
  var nb = checkBadges(p);
  if(nb.length){ saveProgress(p); }
  renderStarPanel(p);
  renderBadgeWall(p);
}
function updateCombo(rightInRow){
  var p = getProgress();
  if(rightInRow > p.bestCombo){ p.bestCombo = rightInRow; saveProgress(p); checkAndSync(); }
}

/* ================= 设置抽屉 ================= */
var drawerOpen = false;
function openDrawer(){ drawerOpen = true; $('drawerMask').classList.add('open'); $('drawer').classList.add('open'); }
function closeDrawer(){ drawerOpen = false; $('drawerMask').classList.remove('open'); $('drawer').classList.remove('open'); }
$('openSettings').addEventListener('click', openDrawer);
$('drawerMask').addEventListener('click', closeDrawer);
function verifyPin(){
  var s = getSettings();
  var v = $('pinInput').value;
  if(v !== s.pin){ toast('密码不对，问问爸爸妈妈吧～'); return false; }
  return true;
}
$('btnExport').addEventListener('click', function(){
  if(!verifyPin()) return;
  var data = { progress: getProgress(), daily: getDaily(), settings: getSettings(), ver: 1 };
  var blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  var a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = '学习乐园数据备份-' + todayStr() + '.json';
  document.body.appendChild(a); a.click(); a.remove();
  toast('📦 数据已导出，请妥善保存！');
});
$('btnImport').addEventListener('click', function(){
  if(!verifyPin()) return;
  $('importFile').click();
});
$('importFile').addEventListener('change', function(e){
  var f = e.target.files[0];
  if(!f) return;
  var reader = new FileReader();
  reader.onload = function(){
    try{
      var d = JSON.parse(reader.result);
      if(!d.progress) throw new Error('bad');
      set(PROGRESS_KEY, d.progress);
      if(d.daily) set(DAILY_KEY, d.daily);
      if(d.settings) set(SETTINGS_KEY, d.settings);
      toast('✅ 数据导入成功！');
      refreshAll();
    }catch(err){ toast('文件格式不对，请选择备份文件'); }
  };
  reader.readAsText(f);
  e.target.value = '';
});
$('btnClearDemo').addEventListener('click', function(){
  if(!verifyPin()) return;
  if(!confirm('确定要清空示例数据吗？\n（你的学习记录也会一并清零，重新开始）')){
    toast('已取消'); return;
  }
  localStorage.removeItem(LS_PREFIX + PROGRESS_KEY);
  localStorage.removeItem(LS_PREFIX + DAILY_KEY);
  toast('🧹 已清空，重新开始吧！');
  refreshAll();
});
$('btnClearAll').addEventListener('click', function(){
  if(!verifyPin()) return;
  if(!confirm('⚠️ 真的要清空全部数据吗？\n所有星星、徽章、学习记录都会删除且无法恢复！')){
    toast('已取消'); return;
  }
  if(!confirm('再次确认：真的要全部删除吗？')) return;
  Object.keys(localStorage).forEach(function(k){ if(k.indexOf(LS_PREFIX) === 0) localStorage.removeItem(k); });
  toast('🗑 数据已全部清空');
  refreshAll();
});
function refreshAll(){
  closeDrawer();
  renderHome();
  if(currentPage === 'english') renderEnglish();
  if(currentPage === 'hanzi') renderHanzi();
  if(currentPage === 'poems') renderPoems();
  if(currentPage === 'math') renderMath();
  if(currentPage === 'logic') newLogicRound();
  if(currentPage === 'adventure') renderAdventure();
}

/* ================= 初始化 ================= */
(function init(){
  var p = getProgress();
  checkBadges(p); saveProgress(p);
  renderHome();
  renderEnglish();
  renderHanzi();
  renderPoems();
  renderMath();
  newLogicRound();
  renderAdventure();
  loadVoices();
  /* 汉字卡片点击使用事件委托，避免动态分页后事件丢失 */
  $('hzGrid').addEventListener('click', function(e){
    var card = e.target.closest('.hz-card');
    if(card && card.dataset.hz) openHzCard(card.dataset.hz);
  });
})();

</script>
</body>
</html>
